[Unit]
Description=Weekly Ranked report, Mondays

[Timer]
# Monday 14:10 UTC: two hours after the map-of-the-day post and an hour
# before the build post, and clear of tiktok-latest at :35 -- every TikTok
# job refreshes the same rotating token, so no two may overlap.
OnCalendar=Mon *-*-* 14:10:00
Persistent=false
Unit=brawlzone-weekly.service

[Install]
WantedBy=timers.target
