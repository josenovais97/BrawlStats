[Unit]
Description=Draw and post the weekly Ranked meta video, Mondays 05:00 UTC

[Timer]
# Between the 04:17 and 06:17 sampler runs and after the Monday restore
# check (04:30, seconds long), so ~25 minutes of rendering has the box.
OnCalendar=Mon *-*-* 05:00:00
Persistent=false
Unit=brawlzone-weekly.service

[Install]
WantedBy=timers.target
