[Unit]
Description=Redeploy BrawlZone when origin/main moves
After=network-online.target docker.service
Wants=network-online.target
# A failed deploy leaves the box on the previous image, serving happily,
# with nothing to say the last few commits never shipped.
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/brawlstats
ExecStart=/usr/local/bin/brawlzone-run deploy /home/ubuntu/auto-deploy.sh
# 30 minutes: after the cache prune at the end of a deploy, the next build is
# cold (migrate image, app, sampler image) and took over 15 minutes on
# 2026-10-15, which killed it mid-build. The timer never overlaps two deploys.
# 45 since 2026-10-19: two builds under load ran past 30 and were killed.
TimeoutStartSec=2700
