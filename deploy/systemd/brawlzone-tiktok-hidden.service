[Unit]
Description=BrawlZone trio-of-the-day carousel to TikTok (unit name kept from the hidden-meta post)
After=docker.service
# Same reasoning as the other three: a failed run that says nothing is worse
# than no run, because "nothing to post" and "the job is broken" look identical
# from the inbox.
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/local/bin/brawlzone-run tiktok-hidden /usr/local/bin/brawlzone-tiktok trio
