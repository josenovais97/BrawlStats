[Unit]
Description=BrawlZone stats sampler
After=docker.service
Requires=docker.service
# Health check 2 catches data going stale, but only after five hours.
# This says so on the first failed run.
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/brawlstats
ExecStart=/usr/local/bin/brawlzone-run sampler /usr/local/bin/brawlzone-sample
# 50 minutes: a run is ~20-28 minutes when the game API is slow (timeouts
# of 1,000-3,800 of 10,000 lookups on 2026-10-14), and 30 killed it seconds
# from the end. Runs are 2 hours apart, so this cannot overlap the next.
TimeoutStartSec=3000
