[Unit]
Description=BrawlZone: an Instagram Story (%i)
After=docker.service network-online.target
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
# A short render on both cores, an encode, an upload; it may wait its turn.
TimeoutStartSec=4200
ExecStart=/usr/local/bin/brawlzone-run ig-story-%i /usr/local/bin/brawlzone-ig-story %i
