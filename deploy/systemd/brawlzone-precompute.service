[Unit]
Description=BrawlZone: compute the expensive reads after a sampler run
After=docker.service
Requires=docker.service
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/local/bin/brawlzone-run precompute /usr/local/bin/brawlzone-precompute
TimeoutStartSec=2700
