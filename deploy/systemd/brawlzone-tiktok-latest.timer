[Unit]
Description=Refresh the newest TikTok post, four times a day

[Timer]
# Clear of both posting timers (09:10 and 17:10) by at least half an hour.
# All three refresh the same TikTok token and TikTok rotates it on use, so two
# of them overlapping would have one save a token the other had already
# invalidated -- a lockout that needs a human with a browser to undo.
#
# Four times a day rather than hourly: the account gets two posts a day, and
# the homepage card carries a 10-minute ISR window on top of this, so a
# tighter schedule would spend requests to show the same row.
OnCalendar=*-*-* 02,10,14,22:05:00
Persistent=false
Unit=brawlzone-tiktok-latest.service

[Install]
WantedBy=timers.target
