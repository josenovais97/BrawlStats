[Unit]
Description=BrawlZone: a new brawler's first-stats post, two days after release
After=docker.service network-online.target
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
TimeoutStartSec=2700
ExecStart=/usr/local/bin/brawlzone-run newbrawler /usr/local/bin/brawlzone-newbrawler
