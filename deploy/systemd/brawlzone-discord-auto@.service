[Unit]
Description=Discord scheduled post: %i
After=network-online.target docker.service
Wants=network-online.target
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/brawlstats
ExecStart=/usr/local/bin/brawlzone-run discord-%i /usr/local/bin/brawlzone-discord-auto %i
TimeoutStartSec=900
