[Unit]
Description=BrawlZone IndexNow submission
After=docker.service
# Search engines stop being told about new pages, and nothing on the
# site changes to show it.
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/brawlzone-run indexnow /usr/local/bin/brawlzone-indexnow
