[Unit]
Description=BrawlZone daily status email
After=docker.service
# The digest is itself a daily report. Losing it loses the thing that
# would otherwise tell you something is wrong.
OnFailure=brawlzone-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/brawlzone-run digest /usr/local/bin/brawlzone-digest
