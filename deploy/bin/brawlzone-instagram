#!/usr/bin/env bash
# Publish one MP4 to the BrawlZone Instagram account as a Reel (2026-10-20).
#
#   brawlzone-instagram <video.mp4> <caption-file>
#   brawlzone-instagram --story <image.jpg>
#
# --story publishes a JPEG as a Story instead (2026-10-21, for
# brawlzone-ig-story). The API takes no stickers, so a Story from here cannot
# carry a link sticker; the image itself has to point at the bio link.
#
# The daily TikTok job calls this with the same slides it posts, rendered by
# its own render_video. Instagram's carousels cannot be 9:16, so the slides go
# out as a Reel, which is also what Instagram shows to non-followers.
#
# Credentials: ~/.brawlzone-instagram.json, {"access_token": "IG..."}, from
# "Generate token" in the Meta app's Instagram API setup (Instagram API with
# Instagram Login; the account is an Instagram Tester of the app, so no app
# review is needed to post to it). The token lives 60 days and is refreshed
# here once a week, written back to the same file.
#
# Instagram fetches the video itself, by URL: the resumable upload Meta
# documents answers "video_url is required" with an Instagram-Login token
# (tried 2026-10-20). So the file is copied under a random name into
# REEL_DIR, which Caddy serves at /reels/, and deleted on the way out --
# published or not.
set -uo pipefail

TOKEN_FILE="$HOME/.brawlzone-instagram.json"
API="https://graph.instagram.com/v23.0"
REEL_DIR="/var/lib/brawlzone/reels"
SITE="https://brawlzone.net"

die() { echo "$*" >&2; exit 1; }

story=0
if [ "${1:-}" = "--story" ]; then
  story=1; video="${2:-}"; caption_file=""
  [ -f "$video" ] || die "usage: brawlzone-instagram --story <image.jpg>"
else
  video="${1:-}"; caption_file="${2:-}"
  [ -f "$video" ] && [ -f "$caption_file" ] || die "usage: brawlzone-instagram <video.mp4> <caption-file>"
fi
[ -r "$TOKEN_FILE" ] || die "::error::$TOKEN_FILE missing -- generate a token in the Meta app"

json_field () { # field, reads JSON on stdin
  python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get(sys.argv[1], ""); print(v if isinstance(v, str) else json.dumps(v))' "$1" 2>/dev/null
}
api_error () { # reads JSON on stdin; Graph errors carry the useful part in error.message
  python3 -c 'import json,sys
try: d=json.load(sys.stdin); print(d.get("error",{}).get("message") or json.dumps(d)[:300])
except Exception: print("no JSON reply")' 2>/dev/null
}

token=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["access_token"])' "$TOKEN_FILE") \
  || die "::error::no access_token in $TOKEN_FILE"

# A refresh needs the token to be at least a day old and resets its 60 days.
# Weekly leaves seven weeks of slack for the box being down; a failed refresh
# is only a warning, since the token it came with still works.
refreshed=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("refreshed_at", 0))' "$TOKEN_FILE")
if [ $(( $(date +%s) - ${refreshed%.*} )) -gt $((7 * 86400)) ]; then
  reply=$(curl -s --max-time 30 -G "https://graph.instagram.com/refresh_access_token" \
    -d grant_type=ig_refresh_token --data-urlencode "access_token=${token}")
  fresh=$(printf '%s' "$reply" | json_field access_token)
  if [ -n "$fresh" ]; then
    (umask 077; python3 - "$TOKEN_FILE" "$fresh" <<'PY'
import json, os, sys, time
path, token = sys.argv[1], sys.argv[2]
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    json.dump({'access_token': token, 'refreshed_at': int(time.time())}, f)
os.replace(tmp, path)
PY
    ) && token=$fresh && echo "instagram: token refreshed"
  else
    # A token from the dashboard less than a day old cannot be refreshed yet.
    echo "::warning::Instagram token refresh failed: $(printf '%s' "$reply" | api_error)" >&2
  fi
fi

# 1. Where Instagram will fetch it. Anything older than a day is a leftover
# from a run that was killed before its trap.
find "$REEL_DIR" -maxdepth 1 \( -name '*.mp4' -o -name '*.jpg' \) -mmin +1440 -delete 2>/dev/null
name="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n').$([ "$story" = 1 ] && echo jpg || echo mp4)"
install -m 644 "$video" "${REEL_DIR}/${name}" || die "::error::could not stage the video in $REEL_DIR"
trap 'rm -f "${REEL_DIR}/${name}"' EXIT
curl -sf -o /dev/null --max-time 60 "${SITE}/reels/${name}" || die "::error::${SITE}/reels/ does not serve the video"

# 2. The container. Instagram caps captions at 2,200 characters; a Story has none.
if [ "$story" = 1 ]; then
  reply=$(curl -s --max-time 60 -X POST "${API}/me/media" -H "Authorization: Bearer ${token}" \
    -d media_type=STORIES --data-urlencode "image_url=${SITE}/reels/${name}")
else
  caption=$(head -c 2200 "$caption_file")
  reply=$(curl -s --max-time 60 -X POST "${API}/me/media" -H "Authorization: Bearer ${token}" \
    -d media_type=REELS -d share_to_feed=true \
    --data-urlencode "video_url=${SITE}/reels/${name}" --data-urlencode "caption=${caption}")
fi
container=$(printf '%s' "$reply" | json_field id)
[ -n "$container" ] || die "::error::Instagram refused the container: $(printf '%s' "$reply" | api_error)"

# 3. Instagram transcodes before it will publish; a minute is usual.
status=""
for _ in $(seq 1 40); do
  sleep "$([ "$story" = 1 ] && echo 3 || echo 15)"
  status=$(curl -s --max-time 30 -G "${API}/${container}" -H "Authorization: Bearer ${token}" \
    -d fields=status_code | json_field status_code)
  case "$status" in FINISHED|ERROR|EXPIRED) break ;; esac
done
[ "$status" = "FINISHED" ] || die "::error::Instagram did not finish processing the Reel (status ${status:-unknown})"

# 4. Publish, then ask for the link to put in the mail.
reply=$(curl -s --max-time 60 -X POST "${API}/me/media_publish" -H "Authorization: Bearer ${token}" \
  -d "creation_id=${container}")
media=$(printf '%s' "$reply" | json_field id)
[ -n "$media" ] || die "::error::Instagram publish failed: $(printf '%s' "$reply" | api_error)"
link=$(curl -s --max-time 30 -G "${API}/${media}" -H "Authorization: Bearer ${token}" -d fields=permalink | json_field permalink)
if [ "$story" = 1 ]; then
  echo "instagram: story published (media ${media})"
else
  echo "instagram: published ${link:-media ${media}}"
fi
