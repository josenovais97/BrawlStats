#!/usr/bin/env bash
# Write the newest TikTok post into the database, for the homepage card.
#
# WHY THIS RUNS ON THE BOX: reading the account's own posts needs an access
# token, which is minted from a refresh token that TikTok rotates on every use.
# Whatever holds it has to write the new one back, and the app container is
# rebuilt on every deploy. So the box fetches and the site reads.
#
# WHY IT SHARES A STATE FILE WITH THE POSTING JOB AND NOT A SCHEDULE: this and
# `brawlzone-tiktok` both refresh the same token. Two of them overlapping would
# have one save a token the other already invalidated, which locks the
# integration out until somebody authorises by hand. All three timers are
# scheduled clear of each other for that reason.
set -uo pipefail

STATE="${HOME}/.brawlzone-tiktok.json"
ENV_FILE="/home/ubuntu/brawlstats/.env.production"
COMPOSE_DIR="/home/ubuntu/brawlstats"
TOKEN_URL="https://open.tiktokapis.com/v2/oauth/token/"
LIST_URL="https://open.tiktokapis.com/v2/video/list/"

die() { echo "$*" >&2; exit 1; }

[ -f "$ENV_FILE" ] || die "::error::no $ENV_FILE"
CLIENT_KEY=$(grep -oP '^TIKTOK_CLIENT_KEY=\K.*' "$ENV_FILE" | tr -d '"')
CLIENT_SECRET=$(grep -oP '^TIKTOK_CLIENT_SECRET=\K.*' "$ENV_FILE" | tr -d '"')
[ -n "${CLIENT_KEY:-}" ] || die "::error::TIKTOK_CLIENT_KEY missing from $ENV_FILE"

[ -f "$STATE" ] || die "::error::no $STATE — authorise once first"
REFRESH=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("refresh_token",""))' "$STATE")
[ -n "$REFRESH" ] || die "::error::$STATE has no refresh_token"

# ----------------------------------------------------------------- the token
token_json=$(curl -s --max-time 30 -X POST "$TOKEN_URL" \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "client_key=${CLIENT_KEY}" \
  --data-urlencode "client_secret=${CLIENT_SECRET}" \
  --data-urlencode "grant_type=refresh_token" \
  --data-urlencode "refresh_token=${REFRESH}")

ACCESS=$(printf '%s' "$token_json" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("access_token",""))' 2>/dev/null)
[ -n "$ACCESS" ] || die "::error::token refresh failed: $(printf '%s' "$token_json" | head -c 300)"

# Saved before anything else, and a failure to save aborts: a rotated token
# that was never written down is a lockout. Same shape as the posting job,
# including the argv-not-stdin detail -- `python3 -` reads its program from
# stdin, so a heredoc and a pipe cannot both feed it.
python3 - "$STATE" "$token_json" <<'PY'
import json, sys, datetime
state_path = sys.argv[1]
fresh = json.loads(sys.argv[2])
state = json.load(open(state_path))
if fresh.get('refresh_token'):
    state['refresh_token'] = fresh['refresh_token']
state['refreshed_at'] = datetime.datetime.now(datetime.UTC).isoformat()
with open(state_path, 'w') as f:
    json.dump(state, f, indent=2)
PY
saved=$?
[ "$saved" -eq 0 ] || die "::error::could not save the rotated refresh token to $STATE"

# ------------------------------------------------------------------ the post
#
# The newest five: the first is the homepage card, and all five are checked
# for Discord below, so two posts published inside one 2-hour gap both get
# announced. The field list is explicit and required: TikTok returns nothing
# useful without it.
response=$(curl -s --max-time 60 -X POST "$LIST_URL?fields=id,title,video_description,share_url,cover_image_url,create_time" \
  -H "Authorization: Bearer ${ACCESS}" \
  -H 'Content-Type: application/json; charset=UTF-8' \
  --data-raw '{"max_count":5}')

ERR=$(printf '%s' "$response" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("error",{}).get("code",""))' 2>/dev/null)
case "$ERR" in
  ok|'') : ;;
  scope_not_authorized)
    die "::error::video.list is not granted. Add the scope in the TikTok portal, then re-authorise once." ;;
  *)
    die "::error::TikTok refused the list: $(printf '%s' "$response" | head -c 400)" ;;
esac

# IFS=tab, or `read` splits on spaces: the title is a sentence, so without
# this it takes the first WORD and every field after it shifts by one. The
# posting job had the same fault and this reproduced it -- the tab is the
# separator the generator emits and it has to be the separator here.
IFS=$'\t' read -r POST_ID URL TITLE COVER CREATED < <(
  printf '%s' "$response" | python3 -c '
import json, sys
videos = json.load(sys.stdin).get("data", {}).get("videos", [])
if not videos:
    sys.exit(2)
v = videos[0]
# A photo post carries its text in video_description; title is often empty.
title = (v.get("title") or v.get("video_description") or "").replace("\t", " ").strip()
print("\t".join([
    str(v.get("id", "")),
    v.get("share_url", "") or "",
    title[:300] or "-",
    v.get("cover_image_url", "") or "-",
    str(v.get("create_time", "") or ""),
]))
' 2>/dev/null
) || true

if [ -z "${POST_ID:-}" ]; then
  # An account with no posts yet is not an error. The card renders nothing.
  echo "no posts returned; leaving the row as it is"
  exit 0
fi

# ------------------------------------------------------------------ the row
#
# Written with psql inside the db container rather than through Prisma: this is
# one upsert of one row from a bash job, and pulling the app's toolchain onto
# the box to do it would be the larger moving part.
cd "$COMPOSE_DIR" || die "::error::no $COMPOSE_DIR"
POST_ID="$POST_ID" URL="$URL" TITLE="$TITLE" COVER="$COVER" CREATED="$CREATED" \
python3 - > /tmp/brawlzone-tiktok-latest.sql <<'PY'
import os
def q(v):
    return "NULL" if v in (None, "", "-") else "'" + v.replace("'", "''") + "'"
created = os.environ.get("CREATED", "")
posted = f"to_timestamp({int(created)})" if created.isdigit() and created != "0" else "NULL"
print(f"""INSERT INTO tiktok_latest_post (id, post_id, url, title, cover_url, posted_at, refreshed_at)
VALUES (1, {q(os.environ['POST_ID'])}, {q(os.environ['URL'])}, {q(os.environ['TITLE'])},
        {q(os.environ['COVER'])}, {posted}, now())
ON CONFLICT (id) DO UPDATE SET
  post_id = EXCLUDED.post_id, url = EXCLUDED.url, title = EXCLUDED.title,
  cover_url = EXCLUDED.cover_url, posted_at = EXCLUDED.posted_at,
  refreshed_at = now();""")
PY

docker compose exec -T db psql -U brawlzone -d brawlzone -v ON_ERROR_STOP=1 \
  -f - < /tmp/brawlzone-tiktok-latest.sql >/dev/null \
  || die "::error::could not write the row"
rm -f /tmp/brawlzone-tiktok-latest.sql

echo "latest post ${POST_ID} -> ${URL}"

# ------------------------------------------------------------ Discord #clips
#
# Every newly published post, linked in the server's #🎬-clips (2026-10-13):
# Discord unfurls a TikTok link into a playable card, so the post reaches the
# server without anyone pasting it. Posts reach TikTok as drafts and go public
# when the account holder publishes them, which is why this hangs off the job
# that sees *published* posts rather than off the posting job.
#
# Announced ids are kept in the state file. The first run seeds that list with
# everything already up and announces only the newest, and only if it went up
# in the last day, so turning this on does not replay the back catalogue.
# Never fatal: the homepage row above is this job's real work.
DISCORD_TOKEN=$(grep -oP '^DISCORD_BOT_TOKEN=\K.*' "$ENV_FILE" | tr -d '"')
DISCORD_GUILD=$(grep -oP '^DISCORD_GUILD_ID=\K.*' "$ENV_FILE" | tr -d '"')
if [ -n "${DISCORD_TOKEN:-}" ] && [ -n "${DISCORD_GUILD:-}" ]; then
  DISCORD_TOKEN="$DISCORD_TOKEN" DISCORD_GUILD="$DISCORD_GUILD" \
  python3 - "$STATE" "$response" <<'PY' || echo "discord: announcement failed (not fatal)"
import json, os, re, sys, time, urllib.request

state_path, raw = sys.argv[1], sys.argv[2]
videos = json.loads(raw).get("data", {}).get("videos", [])
state = json.load(open(state_path))
seen = state.get("discord_announced")
first_run = seen is None
seen = list(seen or [])

api = "https://discord.com/api/v10"
headers = {
    "Authorization": f"Bot {os.environ['DISCORD_TOKEN']}",
    "Content-Type": "application/json",
    "User-Agent": "BrawlZone (https://brawlzone.net, 1.0)",
}

def call(method, path, body=None):
    req = urllib.request.Request(api + path, method=method, headers=headers,
                                 data=None if body is None else json.dumps(body).encode())
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read() or b"{}")

fresh = [v for v in videos if str(v.get("id")) not in seen and v.get("share_url")]
if first_run:
    # Everything already up counts as announced; only a post from the last day
    # is worth a message now.
    newest = videos[0] if videos else None
    seen = [str(v.get("id")) for v in videos]
    fresh = [newest] if newest and time.time() - int(newest.get("create_time") or 0) < 86400 else []

if fresh:
    channels = call("GET", f"/guilds/{os.environ['DISCORD_GUILD']}/channels")
    clips = next((c["id"] for c in channels if c.get("name") == "🎬-clips"), None)
    if clips is None:
        print("discord: no #🎬-clips channel; nothing announced")
        fresh = []
    # Oldest first, so the channel reads in the order they went up.
    for v in sorted(fresh, key=lambda v: int(v.get("create_time") or 0)):
        # The caption's first sentence, not the whole caption cut off: photo
        # posts carry their text in the description, and it runs long.
        text = (v.get("title") or v.get("video_description") or "").split(" #")[0].strip()
        m = re.match(r"(.+?[.!?])(\s|$)", text)
        title = (m.group(1) if m else text)[:120]
        # The share link without TikTok's tracking query; it unfurls the same.
        url = v["share_url"].split("?")[0]
        content = (f"**{title}**\n" if title else "") + f"New on our TikTok 👉 {url}"
        call("POST", f"/channels/{clips}/messages", {"content": content, "allowed_mentions": {"parse": []}})
        seen.append(str(v.get("id")))
        print(f"discord: announced {v.get('id')} in #🎬-clips")

state = json.load(open(state_path))  # re-read: the token was written above
state["discord_announced"] = seen[-50:]
with open(state_path, "w") as f:
    json.dump(state, f, indent=2)
PY
fi

# ------------------------------------------------- weekly report, #mod-updates
#
# Which post formats actually work, every Monday (2026-10-13): views, likes,
# shares and comments per format for the last seven days, plus the best and the
# weakest post, in the private #🔒-mod-updates. Formats are told apart by the
# caption each one writes. Once per ISO week, recorded in the state file.
# Never fatal.
if [ -n "${DISCORD_TOKEN:-}" ] && [ -n "${DISCORD_GUILD:-}" ] && [ "$(date -u +%u)" = "1" ]; then
  stats=$(curl -s --max-time 60 -X POST "$LIST_URL?fields=id,title,video_description,share_url,create_time,view_count,like_count,comment_count,share_count" \
    -H "Authorization: Bearer ${ACCESS}" \
    -H 'Content-Type: application/json; charset=UTF-8' \
    --data-raw '{"max_count":20}')
  DISCORD_TOKEN="$DISCORD_TOKEN" DISCORD_GUILD="$DISCORD_GUILD" \
  python3 - "$STATE" "$stats" <<'PY' || echo "discord: weekly report failed (not fatal)"
import datetime, json, os, sys, time, urllib.request

state_path, raw = sys.argv[1], sys.argv[2]
state = json.load(open(state_path))
week = datetime.date.today().isocalendar()
week_key = f"{week[0]}-W{week[1]:02d}"
if state.get("weekly_report") == week_key:
    sys.exit(0)

videos = json.loads(raw).get("data", {}).get("videos", [])
since = time.time() - 7 * 86400
recent = [v for v in videos if int(v.get("create_time") or 0) >= since]

def fmt(v):
    t = (v.get("title") or v.get("video_description") or "").lower()
    if "how to beat" in t or "struggling against" in t: return "Counter of the day"
    if "best team" in t or t.startswith("run "): return "Trio of the day"
    if "build" in t: return "Build of the day"
    if "best brawlers for" in t or "who to pick on" in t: return "Map of the day"
    return "Other"

groups = {}
for v in recent:
    groups.setdefault(fmt(v), []).append(v)

def avg(vs, k):
    return sum(int(v.get(k) or 0) for v in vs) / len(vs) if vs else 0

lines = []
for name, vs in sorted(groups.items(), key=lambda kv: -avg(kv[1], "view_count")):
    lines.append(
        f"**{name}** · {len(vs)} post{'s' if len(vs) != 1 else ''} · "
        f"{avg(vs,'view_count'):,.0f} views · {avg(vs,'like_count'):,.0f} likes · "
        f"{avg(vs,'share_count'):,.0f} shares · {avg(vs,'comment_count'):,.0f} comments (avg)"
    )

def title(v):
    return (v.get("title") or v.get("video_description") or "").split(" #")[0][:80]

fields = []
if recent:
    best = max(recent, key=lambda v: int(v.get("view_count") or 0))
    worst = min(recent, key=lambda v: int(v.get("view_count") or 0))
    fields.append({"name": "Most viewed", "value": f"{title(best)} · {int(best.get('view_count') or 0):,} views\n{best.get('share_url','').split('?')[0]}"})
    if worst is not best:
        fields.append({"name": "Least viewed", "value": f"{title(worst)} · {int(worst.get('view_count') or 0):,} views"})

embed = {
    "title": "📊 TikTok this week",
    "description": "\n".join(lines) if lines else "No posts went up in the last 7 days.",
    "color": 0xFFC93C,
    "fields": fields,
    "footer": {"text": f"Last 7 days · {len(recent)} posts · from TikTok's own counts"},
}

api = "https://discord.com/api/v10"
headers = {
    "Authorization": f"Bot {os.environ['DISCORD_TOKEN']}",
    "Content-Type": "application/json",
    "User-Agent": "BrawlZone (https://brawlzone.net, 1.0)",
}
def call(method, path, body=None):
    req = urllib.request.Request(api + path, method=method, headers=headers,
                                 data=None if body is None else json.dumps(body).encode())
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read() or b"{}")

channels = call("GET", f"/guilds/{os.environ['DISCORD_GUILD']}/channels")
mod = next((c["id"] for c in channels if c.get("name") == "🔒-mod-updates"), None)
if mod is None:
    print("discord: no #🔒-mod-updates; weekly report skipped")
    sys.exit(0)
call("POST", f"/channels/{mod}/messages", {"embeds": [embed], "allowed_mentions": {"parse": []}})
state = json.load(open(state_path))
state["weekly_report"] = week_key
with open(state_path, "w") as f:
    json.dump(state, f, indent=2)
print(f"discord: weekly TikTok report posted for {week_key}")
PY
fi
