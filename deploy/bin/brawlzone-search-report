#!/usr/bin/env bash
# Google Search, weekly: what people found us for, and which key pages Google knows (2026-10-22).
#
#   brawlzone-search-report
#
# Run on Mondays at 08:10 UTC by brawlzone-search-report.timer, and mailed.
# Reads Search Console through a read-only service account
# (~/.brawlzone-search.json: brawlzone-search@brawlzone.iam.gserviceaccount.com,
# added as a user of the sc-domain:brawlzone.net property). Search Console
# data lags two to three days, so "this week" ends three days ago.
#
# Brand searches ("brawlzone") are reported apart: on 2026-10-22 they were
# 113 of 116 clicks, and the non-brand number is the one that says whether
# the site is being found by people who did not already know it.
#
# Also inspects a short list of key pages: on 2026-10-22 /brawlers/vince,
# /account-value and /brawlers/amber/counters were "unknown to Google".
set -uo pipefail

KEY=/home/ubuntu/.brawlzone-search.json
[ -r "$KEY" ] || { echo "::error::$KEY missing" >&2; exit 1; }

python3 - "$KEY" > /tmp/brawlzone-search-report.txt <<'PY' || exit 1
import base64, datetime, json, os, re, subprocess, sys, tempfile, time, urllib.parse, urllib.request

k = json.load(open(sys.argv[1]))
b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=')
now = int(time.time())
head = b64(json.dumps({'alg': 'RS256', 'typ': 'JWT'}).encode())
claim = b64(json.dumps({'iss': k['client_email'], 'scope': 'https://www.googleapis.com/auth/webmasters.readonly',
                        'aud': k['token_uri'], 'iat': now, 'exp': now + 3600}).encode())
fd, kp = tempfile.mkstemp(); os.write(fd, k['private_key'].encode()); os.close(fd)
try:
    sig = subprocess.run(['openssl', 'dgst', '-sha256', '-sign', kp], input=head + b'.' + claim, capture_output=True, check=True).stdout
finally:
    os.unlink(kp)
tok = json.load(urllib.request.urlopen(urllib.request.Request(k['token_uri'], data=urllib.parse.urlencode(
    {'grant_type': 'urn:ietf:params:oauth:grant-type:jwt-bearer', 'assertion': (head + b'.' + claim + b'.' + b64(sig)).decode()}).encode())))['access_token']
H = {'Authorization': f'Bearer {tok}', 'Content-Type': 'application/json'}
SITE = 'sc-domain%3Abrawlzone.net'

def q(dims, start, end, limit=1000):
    body = {'startDate': str(start), 'endDate': str(end), 'dimensions': dims, 'rowLimit': limit}
    req = urllib.request.Request(f'https://www.googleapis.com/webmasters/v3/sites/{SITE}/searchAnalytics/query', data=json.dumps(body).encode(), headers=H)
    return json.load(urllib.request.urlopen(req, timeout=60)).get('rows', [])

brand = re.compile(r'brawl ?zone', re.I)
end = datetime.date.today() - datetime.timedelta(days=3)
weeks = [(end - datetime.timedelta(days=6), end), (end - datetime.timedelta(days=13), end - datetime.timedelta(days=7))]

def split(rows):
    out = {'brand': [0, 0], 'other': [0, 0]}
    for r in rows:
        b = 'brand' if brand.search(r['keys'][0]) else 'other'
        out[b][0] += r['clicks']; out[b][1] += r['impressions']
    return out

this_rows = q(['query', 'page'], *weeks[0])
tot = [q([], *w) for w in weeks]
print(f'WEEK {weeks[0][0]} to {weeks[0][1]} (Search Console lags ~3 days)\n')
for label, t in zip(('this week', 'week before'), tot):
    t = t[0] if t else {'clicks': 0, 'impressions': 0, 'position': 0}
    print(f"  {label:12} {t['clicks']:5.0f} clicks  {t['impressions']:6.0f} impressions  avg position {t['position']:.1f}")
s = split(this_rows)
print(f"\n  found by people who searched our name:  {s['brand'][0]:.0f} clicks")
print(f"  found by everything else:               {s['other'][0]:.0f} clicks, {s['other'][1]:.0f} impressions")

nb = [r for r in this_rows if not brand.search(r['keys'][0])]
print('\nNON-BRAND SEARCHES WE APPEARED FOR (most seen first)')
for r in sorted(nb, key=lambda r: -r['impressions'])[:15]:
    print(f"  pos {r['position']:5.1f}  {r['impressions']:4.0f} seen  {r['clicks']:3.0f} clicks  {r['keys'][0][:42]:42} {r['keys'][1].replace('https://brawlzone.net', '')}")
close = [r for r in nb if 8 <= r['position'] <= 20]
if close:
    print('\nCLOSE TO PAGE 1 (positions 8-20): worth improving those pages')
    for r in sorted(close, key=lambda r: r['position'])[:8]:
        print(f"  pos {r['position']:5.1f}  {r['keys'][0][:42]:42} {r['keys'][1].replace('https://brawlzone.net', '')}")

print('\nKEY PAGES IN GOOGLE')
for path in ['/', '/tier-list/ranked', '/ranked', '/brawlers/vince', '/account-value', '/brawlers/amber/counters',
             '/starr-drops', '/pt/tier-list/ranked', '/es/tier-list/ranked', '/bubble']:
    body = {'inspectionUrl': 'https://brawlzone.net' + path, 'siteUrl': 'sc-domain:brawlzone.net'}
    try:
        r = json.load(urllib.request.urlopen(urllib.request.Request('https://searchconsole.googleapis.com/v1/urlInspection/index:inspect',
                                                                     data=json.dumps(body).encode(), headers=H), timeout=60))
        i = r['inspectionResult']['indexStatusResult']
        print(f"  {path:28} {i.get('coverageState', '?')}")
    except Exception as e:  # noqa: BLE001
        print(f'  {path:28} could not inspect: {e}')
PY

. /usr/local/lib/brawlzone-html.sh
{
  html_open "Google Search this week" "brawlzone.net in Search Console" "$ACCENT"
  html_section "Results"
  html_pre < /tmp/brawlzone-search-report.txt
  html_close "brawlzone-web &middot; brawlzone-search-report, every Monday"
} | /usr/local/bin/brawlzone-alert --html "[brawlzone] Google Search: weekly report"
cat /tmp/brawlzone-search-report.txt
rm -f /tmp/brawlzone-search-report.txt
