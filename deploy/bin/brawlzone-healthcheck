#!/usr/bin/env bash
# Check the things that fail silently, and email only on a CHANGE of state.
#
# Alerting every run would send six mails an hour while a problem persists,
# which trains you to ignore them. This keeps a state file and mails once when
# something breaks and once when it recovers.
set -uo pipefail

STATE=/var/lib/brawlzone/health.state
SITE=https://brawlzone.net
mkdir -p "$(dirname "$STATE")"

problems=()

# 1. Is the site actually serving?
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$SITE/" || echo 000)
[ "$code" = "200" ] || problems+=("site returned HTTP $code")

# 2. Is the data fresh? The sampler runs every 2h; 5h means runs are failing
#    or the timer stopped, which the OnFailure hook cannot catch because a
#    timer that never fires never fails.
#
#    Successful runs only. A failed run still writes its row, so counting every
#    run made a sampler that fails on every attempt look perfectly healthy --
#    which is exactly what happened during the game API outage on 2026-09-01,
#    while the box collected nothing for hours and reported itself fine.
last=$(cd /home/ubuntu/brawlstats && docker compose exec -T db psql -U brawlzone -d brawlzone -Atc \
  "select extract(epoch from (now() - max(started_at)))::int from aggregation_runs where status <> 'failed';" 2>/dev/null || echo "")
if [ -n "$last" ] && [ "$last" -gt 18000 ]; then
  problems+=("last sampler run was $((last/3600))h ago (expected under 2h)")
fi

# 3. Disk. Postgres, Docker and the dumps all share one volume; a full disk
#    takes all three down at once.
use=$(df --output=pcent / | tail -1 | tr -dc '0-9')
[ "$use" -lt 85 ] || problems+=("disk at ${use}%")

# 4. Are all containers up?
down=$(cd /home/ubuntu/brawlstats && docker compose ps --status exited --status dead -q 2>/dev/null | wc -l)
[ "$down" -eq 0 ] || problems+=("$down container(s) not running")

# 5. Is the Discord invite in the footer still going to work?
#    Discord's default invite lasts 30 days and cannot be extended, so the
#    link on every page of the site expires quietly and nothing else would
#    notice. Two attempts at creating a no-expiry invite both came back as
#    30-day ones, which is exactly why this is checked rather than assumed.
#
#    The code is read out of the footer source rather than repeated here: one
#    source of truth, so replacing the invite in the site cannot leave this
#    check watching the old one.
invite=$(grep -oE 'discord\.gg/[A-Za-z0-9]+' /home/ubuntu/brawlstats/src/components/site-footer.tsx 2>/dev/null | head -1 | cut -d/ -f2)
if [ -n "$invite" ]; then
  inv_json=$(curl -s --max-time 15 "https://discord.com/api/v10/invites/${invite}?with_expiration=true" || echo '')
  inv_msg=$(printf '%s' "$inv_json" | python3 -c '
import sys, json, datetime
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)                      # unreadable: a network blip, not a fault
if "guild" not in d:
    print("Discord invite is dead (%s)" % (d.get("message") or "invalid"))
    sys.exit(0)
exp = d.get("expires_at")
if not exp:
    sys.exit(0)                      # permanent, which is the goal
left = (datetime.datetime.fromisoformat(exp) - datetime.datetime.now(datetime.timezone.utc)).days
if left <= 7:
    print("Discord invite expires in %d day(s)" % left)
' 2>/dev/null || echo '')
  [ -n "$inv_msg" ] && problems+=("$inv_msg")
fi

# 6. Is the box actually running what was pushed?
#    A deploy that silently stops is the worst kind of failure here: every
#    change looks shipped and none of it is. Twenty minutes allows four
#    five-minute timer cycles plus a three-minute build, so a normal deploy
#    never trips this and a stalled one always does.
cd /home/ubuntu/brawlstats 2>/dev/null && {
  git fetch --quiet origin main 2>/dev/null
  head_sha=$(git rev-parse HEAD 2>/dev/null)
  remote_sha=$(git rev-parse origin/main 2>/dev/null)
  if [ -n "$head_sha" ] && [ -n "$remote_sha" ] && [ "$head_sha" != "$remote_sha" ]; then
    pushed_at=$(git log -1 --format=%ct "$remote_sha" 2>/dev/null || echo 0)
    age=$(( $(date +%s) - pushed_at ))
    if [ "$age" -gt 1200 ]; then
      problems+=("box is $((age/60))m behind origin/main (${remote_sha:0:7} not deployed)")
    fi
  fi
}

# 7. Is the update summary still parsing?
#    /release-notes groups an update by what it touched, matching Supercell's
#    own section titles ("NEW Buffies", "Balance Changes"). Those have been
#    stable for over a year, but a rename would not break anything loudly --
#    the category would simply vanish and the page would still look fine.
#
#    Checked through the rendered page rather than by running the parser: it
#    costs one request, needs no container, and tests what a reader actually
#    gets. Only when the page itself is healthy, so a site-wide outage is not
#    reported twice.
notes=$(curl -s --max-time 20 "$SITE/release-notes" || echo "")
if printf '%s' "$notes" | grep -q "Who changed"; then
  if ! printf '%s' "$notes" | grep -qE "New brawlers|New hypercharges|New buffies|Balance changes"; then
    problems+=("release notes parsed but matched no change categories (section titles may have changed)")
  fi
fi

# 8. Has anyone proved the backups still restore?
#    The nightly dump checks its own file; only the weekly restore proves the
#    SQL inside it replays into a database the site would accept. That job is
#    on a timer, and a timer that stops firing never fails -- the same blind
#    spot that let a failing sampler report itself healthy. Ten days allows a
#    missed Monday without crying wolf.
verified=$(cat /home/ubuntu/backups/.last-verified 2>/dev/null || echo "")
if [ -z "$verified" ]; then
  problems+=("backups have never been restore-verified")
else
  vage=$(( ( $(date -u +%s) - $(date -u -d "$verified" +%s) ) / 86400 ))
  [ "$vage" -le 10 ] || problems+=("backups last restore-verified ${vage}d ago (weekly job may have stopped)")
fi

prev=$(cat "$STATE" 2>/dev/null || echo ok)

if [ ${#problems[@]} -eq 0 ]; then
  # Say what was checked. A log that only records that something ran cannot
  # tell you afterwards whether it was actually looking at anything.
  age=$([ -n "$last" ] && echo "$((last / 60))m" || echo "unknown")
  echo "All checks passed: site HTTP $code, data $age old, disk ${use}%, $(cd /home/ubuntu/brawlstats && docker compose ps --services --status running | wc -l) containers up"
  if [ "$prev" != "ok" ]; then
    printf 'Recovered at %s.\n\nAll checks passing:\n  site HTTP 200\n  data fresh\n  disk %s%%\n  containers up\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$use" | /usr/local/bin/brawlzone-alert "RECOVERED"
  fi
  echo ok > "$STATE"
  exit 0
fi

if [ "$prev" = "ok" ]; then
  { printf 'Health check failed at %s.\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for p in "${problems[@]}"; do printf '  - %s\n' "$p"; done
    printf '\nContainers:\n'; (cd /home/ubuntu/brawlstats && docker compose ps 2>&1 | head -8)
  } | /usr/local/bin/brawlzone-alert "UNHEALTHY: ${problems[0]}"
fi
echo failed > "$STATE"
# Exit 0: the alert is the output. A non-zero exit would also trip OnFailure
# and send a second, less useful mail about the checker itself.
exit 0
