#!/usr/bin/env bash
# Find new free Brawl Stars rewards and post them everywhere (2026-10-21).
#
#   brawlzone-rewards-watch
#
# Run every two minutes by brawlzone-rewards-watch.timer. Three sources:
#
# - brawlnetwork.com/rewards, read every ten minutes. Brawl Network (Chosen
#   Network on X) lists every reward link with its name and the day it was
#   added, and had the 2026-10-21 Mega Box / Credits / Power Points set the
#   same day. Only links added in the last two days count: the page keeps
#   pins from 2023, and those must never go out as new.
# - clashloot.gg/bs, read every ten minutes (2026-11-24): a second list, so a
#   reward one of them misses still goes out. Only its verified entries added
#   in the last two days, with a link of Supercell's own.
# - Discord's #🎁-rewards-feed, private to the server owner and the bot. The
#   owner can paste links there from a phone, and announcement channels of
#   other servers can be followed into it; either is posted within minutes.
#   Names come from the text on the link's own line ("Mega Box: link...").
#
# The store's free daily reward (2026-11-24) goes to daily.json, which the card
# on /rewards reads. Only the page changes here; brawlzone-daily-gift may tell
# people about it (a trial), and it never becomes a video. The
# store hides it until you sign in, so its name comes from clashloot.gg/bs, a
# public page that lists it seconds after the 08:00 UTC change: read until
# today's is known, then not again until tomorrow. A line in the Discord
# channel ("today: 100 Coins" from the owner, "Daily freebie: 100 Coins" in a
# followed post) wins over it.
#
# Every new link goes to brawlzone-rewards (Discord, TikTok, YouTube,
# Instagram). Only Supercell's own hosts are accepted there, and a link
# already posted is skipped, so a reward seen in both sources goes out once.
# The first run of each source only records what it already lists.
set -uo pipefail

REPO=/home/ubuntu/brawlstats
ENV_FILE="$REPO/.env.production"
STATE=/var/lib/brawlzone/rewards-watch.json
SEEN=/var/lib/brawlzone/rewards-seen.json

DISCORD_TOKEN=$(grep -oP '^DISCORD_BOT_TOKEN=\K.*' "$ENV_FILE" | tr -d '"')
DISCORD_GUILD=$(grep -oP '^DISCORD_GUILD_ID=\K.*' "$ENV_FILE" | tr -d '"')

# One line per batch to post: brawlzone-rewards' arguments, tab-separated.
batches=$(DISCORD_TOKEN="$DISCORD_TOKEN" DISCORD_GUILD="$DISCORD_GUILD" python3 - "$STATE" "$SEEN" <<'PY'
import datetime, html, json, os, re, sys, time, urllib.request

state_path, seen_path = sys.argv[1], sys.argv[2]
try:
    state = json.load(open(state_path))
except (OSError, ValueError):
    state = {}
# The language segment is optional: the 2026-10-23 Vince Box link was
# link.brawlstars.com/voucher/<id>, with no /en/, and a pattern that required
# one let it go by unposted for the whole day.
#
# Store freebies too (2026-11-06): "10x Gems" was a free product in the
# Supercell Store (store.supercell.com/brawlstars/product/gems/db31bef9),
# claimed on the store with Supercell ID instead of through a voucher link.
# Brawl Network listed it; this pattern only knew vouchers, so it went by.
#
# And the older spelling of a voucher, /?action=voucher&code=<id> (2026-11-24).
URL = re.compile(r'(?:https?://)?(?:link\.brawlstars\.com/(?:[a-z-]+/)?voucher/[0-9a-fA-F-]{36}'
                 r'|link\.brawlstars\.com/(?:[a-z-]+/)?\?action=voucher&(?:amp;)?code=[0-9a-fA-F-]{36}'
                 r'|store\.supercell\.com/[^\s)>\]"\']*voucher=[0-9a-fA-F-]{36}'
                 r'|store\.supercell\.com/(?:[a-z]{2}(?:-[a-zA-Z]{2,4})?/)?brawlstars/product/[a-z-]+/[0-9A-Za-z]+(?:\?[^\s)>\]"\'<]*)?)/?')
VOUCHER = re.compile(r'[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')
PRODUCT = re.compile(r'store\.supercell\.com/(?:[a-z]{2}(?:-[a-zA-Z]{2,4})?/)?brawlstars/product/([a-z-]+)/([0-9A-Za-z]+)')


def norm(u):
    u = (u if u.startswith('http') else 'https://' + u).rstrip('/')
    # A store product link loses its language and any tracking query
    # (Brawl Network adds its creator boost, ?boost=chosen): one clean link.
    m = PRODUCT.search(u)
    if m:
        return f'https://store.supercell.com/brawlstars/product/{m.group(1)}/{m.group(2)}'
    u = u.replace('&amp;', '&')
    if 'link.brawlstars.com' in u and '?' in u and VOUCHER.search(u):
        return f'https://link.brawlstars.com/?action=voucher&code={VOUCHER.search(u).group(0).lower()}'
    return u


def key(u):
    """One reward, however its link is spelt: the voucher id, the product id, else the link."""
    m = VOUCHER.search(u)
    if m:
        return m.group(0).lower()
    p = PRODUCT.search(u)
    return f'product:{p.group(2)}' if p else norm(u)


def arg(name, url):
    return f'{name}: {url}/' if 'link.brawlstars' in url and '?' not in url else f'{name}: {url}'


try:
    seen = {key(u) for u in json.load(open(seen_path))}
except (OSError, ValueError):
    seen = set()


DAILY = '/var/lib/brawlzone/social/rewards/daily.json'
HISTORY = '/var/lib/brawlzone/social/rewards/daily-history.json'
# The owner may be brief ("today: 100 Coins"); a followed post must name it.
DAILY_OWNER = re.compile(r"^\W*(?:today|daily|hoje|freebie)(?:'?s)?(?:\s+(?:free|daily|store|freebie|gift|reward))*(?:\s+is)?\s*[:=–-]\s*(.+)$", re.I)
DAILY_POST = re.compile(r"^\W*(?:today'?s\s+|daily\s+)(?:(?:free|daily|store|freebie|gift|reward)\s*)+(?:is\s*)?[:=–-]\s*(.+)$", re.I)
# Only things the game has: the name goes on a public page by itself.
DAILY_ITEM = re.compile(r'\b(?:coins?|credits?|bling|gems?|power\s*points?|drops?|doublers?|box(?:es)?|pins?|sprays?|icons?|tickets?|tokens?|skins?|pass(?:es)?)\b', re.I)


def tidy_name(name):
    """ "x1 CHAOS DROP" -> "1x Chaos Drop"; None if it is not a thing the game gives. """
    name = re.sub(r"[^A-Za-z0-9 .,'×+-]", ' ', name)
    name = ' '.join(name.split()).strip(" .,'-+")
    name = re.sub(r'^[x×]\s*(\d[\d.,]*)\s+', r'\1x ', name, flags=re.I)
    name = re.sub(r'^(\d[\d.,]*)\s*[x×]\s*', r'\1x ', name, flags=re.I)
    if not 3 <= len(name) <= 40 or not DAILY_ITEM.search(name):
        return None
    letters = re.sub(r'^\d[\d.,]*x?\s*', '', name)
    if letters == letters.upper() or letters == letters.lower():
        name = ' '.join(w if w[0].isdigit() else w.capitalize() for w in name.lower().split())
    return name


def daily_name(line, owner):
    """The reward a line names as today's store gift, tidied, or None."""
    line = re.sub(r'<a?:\w+:\d+>|https?://\S+', ' ', line).replace('’', "'")
    line = re.sub(r'[*_`~|>#\[\]()]', ' ', line)
    m = (DAILY_OWNER if owner else DAILY_POST).match(line.strip())
    if not m:
        return None
    return tidy_name(m.group(1))


def store_day(ms):
    """The store's day at `ms`: it changes at 08:00 UTC (as src/lib/store-daily.ts)."""
    return datetime.datetime.fromtimestamp(ms / 1000 - 8 * 3600, datetime.timezone.utc).strftime('%Y-%m-%d')


def is_daily_link(u):
    """The daily reward's own product page: never posted as a new reward."""
    m = PRODUCT.search(u)
    return bool(m) and m.group(1).startswith('freebie')


def page_items(page):
    """The rewards clashloot.gg/bs carries as JSON, by id."""
    found = {}
    for m in re.finditer(r'\{"id":\d+,"title":[^{}]*\}', page.replace('\\"', '"')):
        try:
            item = json.loads(m.group(0))
        except ValueError:
            continue
        if item.get('game') == 'bs' and isinstance(item.get('id'), int):
            found[item['id']] = item
    return list(found.values())


def new_reward(item):
    """(name, link) of an entry worth posting, else None: verified, not the
    daily one, listed in the last two days, not over, and Supercell's own link."""
    try:
        age = time.time() - datetime.datetime.fromisoformat(item['created_at']).timestamp()
        over = item.get('expires_at') and datetime.datetime.fromisoformat(item['expires_at']).timestamp() < time.time()
    except (ValueError, KeyError, TypeError):
        return None
    if item.get('is_daily') or not item.get('is_verified') or over or not 0 <= age + 300 <= 2 * 86400:
        return None
    link = str(item.get('link') or '')
    hit = URL.fullmatch(link)
    if not hit or is_daily_link(link):
        # A bare store address or a store code: nothing to tap, so a person decides.
        print(f"::warning::clashloot.gg lists {item.get('title')!r} without a link to post: {link[:80]}", file=sys.stderr)
        return None
    name = re.sub(r"[^A-Za-z0-9 .'&+!-]", ' ', str(item.get('title') or ''))
    name = ' '.join(name.split()).strip(" .'-+")
    name = re.sub(r'^[x×]\s*(\d[\d.]*)\s+', r'\1x ', name, flags=re.I)
    if not 3 <= len(name) <= 50:
        return None
    letters = re.sub(r'^\d[\d.]*x?\s*', '', name)
    if letters == letters.upper() or letters == letters.lower():
        name = ' '.join(w if w[0].isdigit() else w.capitalize() for w in name.lower().split())
    return name, norm(link)


def daily_from_page(page, today):
    """Today's store reward as clashloot.gg/bs lists it, or None. The page
    carries each reward as JSON; only a Brawl Stars store item whose day is
    today's counts, so a page not yet updated says nothing."""
    for m in re.finditer(r'\{[^{}]*"is_daily":true[^{}]*\}', page.replace('\\"', '"')):
        try:
            item = json.loads(m.group(0))
            began = datetime.datetime.fromisoformat(item.get('store_cycle_started_at') or item['created_at'])
        except (ValueError, KeyError, TypeError):
            continue
        if item.get('game') != 'bs' or not item.get('is_supercell_store') or store_day(began.timestamp() * 1000) != today:
            continue
        name = tidy_name(str(item.get('title') or ''))
        if name:
            link = norm(str(item.get('link') or ''))
            return {'day': today, 'name': name, **({'url': link} if PRODUCT.search(link) else {})}
    return None


daily = None
batches = []
# Whether any source was actually read this run: /rewards shows "checked N
# minutes ago" from it (2026-10-28), so a run where both failed must not count.
read_ok = False

# ---- brawlnetwork.com/rewards
if time.time() - state.get('polled_brawlnetwork', 0) >= 600:
    state['polled_brawlnetwork'] = time.time()
    try:
        req = urllib.request.Request('https://brawlnetwork.com/rewards/', headers={
            'user-agent': 'Mozilla/5.0 (compatible; BrawlZone/1.0; +https://brawlzone.net)'})
        with urllib.request.urlopen(req, timeout=30) as r:
            page = r.read().decode('utf-8', 'ignore')
    except Exception as e:  # noqa: BLE001 -- the site being down is not our failure
        print(f'::warning::brawlnetwork.com: {e}', file=sys.stderr)
        page = ''
    if page:
        read_ok = True
        text = re.sub(r'<script.*?</script>|<style.*?</style>', ' ', page, flags=re.S)
        # Each card reads "<name> | Added: October 21st, 2026 | ... | <a href=link>".
        flat = html.unescape(re.sub(r'\s+', ' ', re.sub(r'<(?!a\b)[^>]+>', ' | ', text)))
        cutoff = datetime.date.today() - datetime.timedelta(days=2)
        first = 'seeded_brawlnetwork' not in state
        found = {}
        pos = 0
        for hit in URL.finditer(flat):
            before = flat[pos:hit.start()]
            pos = hit.end()
            # The nearest card above the link: cards without a voucher link
            # (store offers) sit between them.
            cards = list(re.finditer(r'([^|]{2,60}?)\s*\|\s*(?:\|\s*)*Added:\s*([A-Za-z]+)\s+(\d{1,2})(?:st|nd|rd|th)?,\s*(\d{4})', before))
            if not cards:
                continue
            m = cards[-1]
            try:
                added = datetime.datetime.strptime(f'{m.group(2)} {m.group(3)} {m.group(4)}', '%B %d %Y').date()
            except ValueError:
                continue
            u = norm(hit.group(0))
            if first or added < cutoff or key(u) in seen or u in found or is_daily_link(u):
                continue
            # A store product is only a reward when its card is a claim
            # ("Claim from Supercell Store"); never a paid offer.
            if PRODUCT.search(u) and 'claim' not in flat[m.end():hit.start()].lower():
                continue
            found[u] = re.sub(r'^(?:limited|new|free)\s+', '', m.group(1).strip(' |'), flags=re.I)
        state['seeded_brawlnetwork'] = True
        if found:
            batches.append('\t'.join(arg(n, u) for u, n in list(found.items())[:4]))
            seen |= {key(u) for u in found}

# ---- clashloot.gg/bs: today's store reward, and any new one
today = store_day(time.time() * 1000)
try:
    known = json.load(open(DAILY)).get('day') == today
except (OSError, ValueError):
    known = False
if time.time() - state.get('polled_clashloot', 0) >= 600:
    state['polled_clashloot'] = time.time()
    try:
        req = urllib.request.Request('https://clashloot.gg/bs', headers={
            'user-agent': 'Mozilla/5.0 (compatible; BrawlZone/1.0; +https://brawlzone.net)'})
        with urllib.request.urlopen(req, timeout=30) as r:
            page = r.read().decode('utf-8', 'ignore')
    except Exception as e:  # noqa: BLE001 -- the site being down is not our failure
        print(f'::warning::clashloot.gg: {e}', file=sys.stderr)
        page = ''
    items = page_items(page)
    if items:
        read_ok = True
        if not known:
            daily = daily_from_page(page, today)
        # The first read only learns what is already listed.
        listed = set(state.get('clashloot_known') or [])
        first = 'clashloot_known' not in state
        found = {}
        for item in items:
            if first or item['id'] in listed:
                continue
            reward = new_reward(item)
            if reward and key(reward[1]) not in seen and reward[1] not in found:
                found[reward[1]] = reward[0]
        state['clashloot_known'] = sorted(listed | {item['id'] for item in items})[-600:]
        if found:
            batches.append('\t'.join(arg(n, u) for u, n in list(found.items())[:4]))
            seen |= {key(u) for u in found}

# ---- Discord #🎁-rewards-feed
if os.environ.get('DISCORD_TOKEN') and os.environ.get('DISCORD_GUILD'):
    api = 'https://discord.com/api/v10'
    headers = {'Authorization': f"Bot {os.environ['DISCORD_TOKEN']}", 'User-Agent': 'BrawlZone (https://brawlzone.net, 1.0)'}

    def call(path):
        req = urllib.request.Request(api + path, headers=headers)
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)

    def name_for(line, start):
        before = re.sub(r'\[|\]\(?$|<$', '', line[:start])
        before = re.sub(r'[^\w\s&+.\'-]', ' ', before)  # emoji, colons, bullets
        before = re.sub(r'\b(claim|here|link|free|get|use)\b', ' ', before, flags=re.I)
        return ' '.join(before.split()[-5:]).strip(' .-') or 'Free Reward'

    # A server that just added the bot gets one message in its system channel
    # (2026-11-24): what it can do, and a button that turns the rewards feed on
    # right there. The first run only learns which servers already have it.
    try:
        servers = {g['id'] for g in call('/users/@me/guilds?limit=200')}
        if 'guilds_known' in state:
            for gid in sorted(servers - set(state['guilds_known'])):
                place = call(f'/guilds/{gid}').get('system_channel_id')
                if not place:
                    continue
                welcome = {
                    'allowed_mentions': {'parse': []},
                    'content': '👋 Thanks for adding **BrawlZone**! It can post every free Brawl Stars reward the moment it drops, and the store\'s free reward every day.\n'
                               'Admins: tap the button to use this channel, or run `/rewards-feed setup #channel`. Everything else it does: `/help`.',
                    'components': [{'type': 1, 'components': [
                        {'type': 2, 'style': 3, 'label': 'Post free rewards here', 'custom_id': 'rewards-feed:here'},
                        {'type': 2, 'style': 5, 'label': 'Free rewards now', 'url': 'https://brawlzone.net/rewards?from=discord-bot'}]}],
                }
                try:
                    req = urllib.request.Request(f'{api}/channels/{place}/messages', method='POST', data=json.dumps(welcome).encode(),
                                                 headers={**headers, 'Content-Type': 'application/json'})
                    urllib.request.urlopen(req, timeout=30).read()
                    print('::notice::welcome sent to a new server', file=sys.stderr)
                except Exception:  # noqa: BLE001 -- it may not let the bot write there
                    print('::notice::a new server does not let the bot write in its system channel', file=sys.stderr)
        state['guilds_known'] = sorted(servers)
    except Exception as e:  # noqa: BLE001 -- never in the way of the rewards
        print(f'::warning::Discord servers: {e}', file=sys.stderr)

    try:
        guild = os.environ['DISCORD_GUILD']
        channel = next((c for c in call(f'/guilds/{guild}/channels') if c.get('name') == '🎁-rewards-feed'), None)
        if channel:
            owner = call(f'/guilds/{guild}')['owner_id']
            messages = call(f"/channels/{channel['id']}/messages?limit=25")
            first = 'last_id' not in state
            last = int(state.get('last_id', 0))
            for m in sorted(messages, key=lambda m: int(m['id'])):
                if int(m['id']) <= last:
                    continue
                last = int(m['id'])
                # Followed posts arrive through a webhook; otherwise only the owner counts.
                if first or not (m.get('webhook_id') or m['author']['id'] == owner):
                    continue
                parts = [m.get('content') or '']
                for e in m.get('embeds', []):
                    parts += [e.get('title') or '', e.get('description') or '']
                    parts += [f"{f.get('name', '')}: {f.get('value', '')}" for f in e.get('fields', [])]
                # A message's id carries when it was sent: a name given before
                # the 08:00 change belongs to the day before.
                sent_day = store_day((int(m['id']) >> 22) + 1420070400000)
                if sent_day == store_day(time.time() * 1000):
                    for line in '\n'.join(parts).splitlines():
                        name = daily_name(line, m['author']['id'] == owner and not m.get('webhook_id'))
                        if name:
                            daily = {'day': sent_day, 'name': name}
                found = {}
                for line in '\n'.join(parts).splitlines():
                    for hit in URL.finditer(line):
                        u = norm(hit.group(0))
                        if key(u) not in seen and u not in found and not is_daily_link(u):
                            found[u] = name_for(line, hit.start())
                if found:
                    batches.append('\t'.join(arg(n, u) for u, n in list(found.items())[:4]))
                    seen |= {key(u) for u in found}
            state['last_id'] = str(last)
            read_ok = True
    except Exception as e:  # noqa: BLE001
        print(f'::warning::Discord: {e}', file=sys.stderr)

if daily:
    try:
        json.dump({**daily, 'setAt': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')},
                  open(DAILY + '.tmp', 'w'), ensure_ascii=False)
        os.replace(DAILY + '.tmp', DAILY)
        batches.insert(0, '@daily ' + daily['name'])
        # Every day's, kept: the calendar is drawn from it.
        try:
            log = json.load(open(HISTORY))
        except (OSError, ValueError):
            log = {}
        log[daily['day']] = {k: v for k, v in daily.items() if k != 'day'}
        json.dump(log, open(HISTORY + '.tmp', 'w'), ensure_ascii=False, indent=1, sort_keys=True)
        os.replace(HISTORY + '.tmp', HISTORY)
    except OSError as e:
        print(f'::warning::daily.json: {e}', file=sys.stderr)

if read_ok:
    checked = '/var/lib/brawlzone/social/rewards/checked.json'
    try:
        json.dump({'checkedAt': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}, open(checked + '.tmp', 'w'))
        os.replace(checked + '.tmp', checked)
    except OSError as e:
        print(f'::warning::checked.json: {e}', file=sys.stderr)

json.dump(state, open(state_path + '.tmp', 'w')); os.replace(state_path + '.tmp', state_path)
print('\n'.join(batches))
PY
) || { echo "::error::the rewards watcher failed" >&2; exit 1; }

while IFS= read -r line; do
  [ -n "$line" ] || continue
  # The store's daily reward: only the page changes, so refresh it and move on.
  if [[ "$line" == "@daily "* ]]; then
    echo "today's store reward: ${line#@daily }"
    CRON_SECRET="$(sed -n 's/^CRON_SECRET=//p' "$ENV_FILE" | head -1 | sed 's/^["'"'"']//; s/["'"'"']$//')"
    curl -s -o /dev/null -w 'revalidate: HTTP %{http_code}\n' --max-time 30 -X POST \
      -H "Authorization: Bearer $CRON_SECRET" https://brawlzone.net/api/cron/revalidate-rewards || echo "::warning::revalidate not reached"
    continue
  fi
  IFS=$'\t' read -r -a args <<< "$line"
  echo "new rewards: ${args[*]}"
  /usr/local/bin/brawlzone-rewards "${args[@]}" || echo "::warning::brawlzone-rewards failed for: ${args[*]}"
done <<< "$batches"

# The daily reward's own posts: other servers, Telegram, and the alert trial (it checks what is due).
/usr/local/bin/brawlzone-daily-gift || echo "::warning::brawlzone-daily-gift failed"
