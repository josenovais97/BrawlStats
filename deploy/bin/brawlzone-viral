#!/usr/bin/env bash
# The daily viral Short (2026-10-22): a beat-synced motion-graphics video,
# drawn from today's data and posted to TikTok (inbox), YouTube and Instagram.
#
#   brawlzone-viral [--no-post] [quiz|broken|ranks|modes]
#   brawlzone-viral [--no-post] extra|everyrank|classrank|stop|drops|whatsnew
#   brawlzone-viral [--no-post] newbrawler <dir>
#   brawlzone-viral [--no-post] daily
#
# Run at 15:30 UTC by brawlzone-viral.timer. A quiz every day since
# 2026-10-29 (the channel's best format), themed by weekday:
#
#   Mon shadowquiz  Tue quiz  Wed zoomquiz  Thu skinquiz  Fri shadowquiz  Sat quiz  Sun iconquiz
#   (skinquiz and iconquiz from 2026-11-05: the brawler in one of its Fan Kit skins, or from one of its ability icons)
#
# deploy/viral/make.py draws it (formats described there). `broken` needs a
# snapshot from about a week ago, which this job keeps in $ROOT/history, and
# on a flat week it says so and the quiz goes out instead. Naming a format
# overrides the day's; --no-post renders it and stops, for a look at
# $PUBLIC/<date>/video.mp4 first.
#
# A file $ROOT/skip-YYYY-MM-DD makes that day's run do nothing: for a day a
# hand-made video takes the slot.
#
# `extra` is the second data video (2026-10-26, brawlzone-viral-extra at
# 14:00), in the slot the account-value Short and the trio/build carousels
# gave up for doing worst. By weekday, since 2026-10-29 with the data
# formats the daily quiz moved out of 15:30:
#
#   Mon drops  Tue stop  Wed ranks  Thu whatsnew  Fri broken (giveaway to Nov 30)  Sat modes  Sun everyrank
#   (drops: "I opened 1,000 X", a different drop or box each week, from 2026-11-09)
#
# Fridays until the giveaway closes (2026-11-30) are its reminder instead.
#
# everyrank is "Every brawler ranked from worst to best" (the channel's best
# Short so far, now weekly), classrank the same countdown for one class or
# rarity at a time, stop "STOP picking these brawlers". Each has its own
# folder, $PUBLIC/<date>-<kind>, beside the 15:30 one.
#
# `newbrawler` is brawlzone-newbrawler's: <dir> (under /var/lib/brawlzone/
# social) holds the brawler's report.json and hero.png, maybe gadget.png and
# starpower.png, and the video is drawn and posted from there, any day.
#
# `daily` is the second video of the day (2026-10-23, brawlzone-viral-daily
# at 18:10): the site's own Zoom puzzle as a teaser, fetched from the live
# /api/brawldle/picture, which never names the answer. YouTube, Instagram and
# Discord only (TIKTOK=0), into $PUBLIC/<date>-daily.
#
# The posting is brawlzone-tiktok's `viral` mode: one TikTok inbox upload,
# then the same file to YouTube, Instagram and Discord, then the mail with
# the caption. This job remembers the episode numbers and the quiz answers
# already used ($ROOT/state.json) only once that has run.
set -uo pipefail

REPO=/home/ubuntu/brawlstats
ROOT=/var/lib/brawlzone/viral
CACHE=/var/lib/brawlzone/viral-cache     # fonts, icon, models/, faces/, py/
PUBLIC=/var/lib/brawlzone/social/viral    # served at https://brawlzone.net/social/viral/
SITE=https://brawlzone.net
MUSIC_DIR="$HOME/youtube-music"
PYTHON_IMAGE="python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1"
FFMPEG_IMAGE="lscr.io/linuxserver/ffmpeg:9.0-cli-ls84"

die() { echo "$*" >&2; exit 1; }

post=1
[ "${1:-}" = "--no-post" ] && { post=0; shift; }
kind="${1:-}"
DAY=$(date -u +%Y-%m-%d)

skip=0
[ -z "$kind" ] && [ -e "$ROOT/skip-$DAY" ] && skip=1
if [ -z "$kind" ]; then
  case "$(date -u +%u)" in
    1|5) kind=shadowquiz ;;
    3) kind=zoomquiz ;;
    4) kind=skinquiz ;;
    7) kind=iconquiz ;;
    *) kind=quiz ;;
  esac
fi
if [ "$kind" = extra ]; then
  case "$(date -u +%u)" in
    1) kind=drops ;;
    2) kind=stop ;;
    3) kind=ranks ;;
    4) kind=whatsnew ;;
    5) if [ "$DAY" \< 2026-11-30 ]; then kind=giveaway; else kind=broken; fi ;;
    6) kind=modes ;;
    7) kind=everyrank ;;
    *) kind=classrank ;;
  esac
fi

case "$kind" in quiz|shadowquiz|zoomquiz|skinquiz|iconquiz|broken|ranks|modes|newbrawler|daily|everyrank|classrank|stop|giveaway|drops|whatsnew) ;;
  *) die "::error::unknown format '$kind' (quiz, shadowquiz, zoomquiz, skinquiz, iconquiz, broken, ranks, modes, newbrawler, daily, extra, everyrank, classrank, stop, giveaway, drops or whatsnew)" ;; esac

if [ "$kind" = newbrawler ]; then
  OUT="${2:-}"
  case "$OUT" in /var/lib/brawlzone/social/?*) ;; *) die "::error::newbrawler needs its folder under /var/lib/brawlzone/social" ;; esac
  [ -r "$OUT/report.json" ] && [ -r "$OUT/hero.png" ] || die "::error::no report.json or hero.png in $OUT"
  DATA_IN=/out/report.json
  PREV=-
elif [ "$kind" = daily ]; then
  OUT="$PUBLIC/$DAY-daily"
  DATA_IN=/out/daily.json
  PREV=-
elif [ "$kind" = everyrank ] || [ "$kind" = classrank ] || [ "$kind" = stop ] \
     || [ "$kind" = broken ] || [ "$kind" = ranks ] || [ "$kind" = modes ] || [ "$kind" = giveaway ] || [ "$kind" = drops ] \
     || [ "$kind" = whatsnew ]; then
  OUT="$PUBLIC/$DAY-$kind"
  DATA_IN="/data/history/$DAY.json"
else
  OUT="$PUBLIC/$DAY"
  DATA_IN="/data/history/$DAY.json"
fi
FOLDER=${OUT#/var/lib/brawlzone/social/}
mkdir -p "$ROOT/history" "$CACHE/models" "$CACHE/faces" "$OUT" || die "::error::cannot create $ROOT or $OUT"
# The music (2026-10-28, owner: "it's always the same"): the tracks in
# deploy/viral/tracks.json in turn by day, the 14:00 slot one ahead of the
# others so the two videos of a day differ. TRACK=<name> overrides.
TRACK=${TRACK:-$(python3 - "$REPO/deploy/viral/tracks.json" "$kind" <<'PY'
import datetime, json, sys
names = sorted(json.load(open(sys.argv[1])))
extra = sys.argv[2] in ('broken', 'ranks', 'modes', 'stop', 'everyrank', 'classrank', 'giveaway', 'drops', 'whatsnew')
print(names[(datetime.date.today().toordinal() + extra) % len(names)])
PY
)}
mapfile -t TR < <(python3 -c 'import json,sys; t=json.load(open(sys.argv[1]))[sys.argv[2]]; print(t["file"]); print(t["start"])' \
  "$REPO/deploy/viral/tracks.json" "$TRACK" 2>/dev/null)
[ "${#TR[@]}" = 2 ] || die "::error::unknown track '$TRACK'"
MUSIC="$MUSIC_DIR/${TR[0]}" MUSIC_START="${TR[1]}"
[ -r "$MUSIC" ] || die "::error::the track is missing: $MUSIC"
echo "music: $TRACK"
cp "$REPO/public/fonts/LilitaOne-Regular.ttf" "$REPO/public/fonts/Geist-Regular.ttf" \
   "$REPO/public/bubble/app-icon.png" "$CACHE/" || die "::error::fonts or icon missing from the checkout"
# The giveaway's prize art: the owner's Brawl Pass in $CACHE/brawl-pass.png when
# present, else this box (make.py prize_art).
cp "$REPO/public/rewards/box-rainbow.png" "$CACHE/" 2>/dev/null
# The drops video's reward icons (2026-10-29). Its Chaos Drop, Star Power and
# gadget art are not in the repo: they were cached in $CACHE/drops by hand, and
# make.py exits 3 without the drop.
mkdir -p "$CACHE/drops"
cp "$REPO"/public/rewards/art/{coins,power-points,credits,bling}.png "$REPO"/public/icons/{hypercharge,buffie,skin-legendary,brawlers}.png "$CACHE/drops/" 2>/dev/null

if [ "$kind" = daily ]; then
  # The puzzle as the site serves it right now: four zoom steps and the
  # shadow. #1 was 2026-10-02, as on the share card.
  for i in 0 1 2 3; do
    curl -sf --max-time 60 -A 'BrawlZone viral (https://brawlzone.net)' -o "$OUT/zoom-$i.webp" \
      "$SITE/api/brawldle/picture?mode=zoom&step=$i&d=$DAY" || die "::error::could not fetch zoom step $i from the site"
  done
  curl -sf --max-time 60 -A 'BrawlZone viral (https://brawlzone.net)' -o "$OUT/shadow.webp" \
    "$SITE/api/brawldle/picture?mode=shadow&step=0&d=$DAY" || die "::error::could not fetch the shadow from the site"
  printf '{"date": "%s", "number": %d}\n' "$DAY" $(( ( $(date -u -d "$DAY" +%s) - $(date -u -d 2026-10-01 +%s) ) / 86400 )) > "$OUT/daily.json"
fi

if [ "$kind" != newbrawler ] && [ "$kind" != daily ]; then

# ---------------------------------------------------------------- data
cd "$REPO" || die "::error::no checkout at $REPO"
docker compose run --rm -T sampler node --import tsx --conditions=react-server scripts/viral-data.ts \
  2> "$CACHE/data.err" | grep '^{' > "$ROOT/history/$DAY.json.new"
[ -s "$ROOT/history/$DAY.json.new" ] || die "::error::scripts/viral-data.ts printed nothing: $(tail -c 400 "$CACHE/data.err")"
mv "$ROOT/history/$DAY.json.new" "$ROOT/history/$DAY.json"
# A month of snapshots is plenty; `broken` reads the one from a week ago.
find "$ROOT/history" -name '*.json' -mtime +40 -delete 2>/dev/null

# After the snapshot, so a skipped day still leaves one for next week.
if [ "$skip" = 1 ]; then
  echo "skip-$DAY is set: a hand-made video has today's slot"
  exit 0
fi

# The snapshot closest to seven days old, at least four (so the two 3-day
# windows do not overlap), or none: make.py then compares with the week.
PREV=$(python3 - "$ROOT/history" "$DAY" <<'PY'
import datetime, os, sys
d, today = sys.argv[1], datetime.date.fromisoformat(sys.argv[2])
best = None
for f in os.listdir(d):
    try:
        age = (today - datetime.date.fromisoformat(f[:10])).days
    except ValueError:
        continue
    if 4 <= age <= 10 and (best is None or abs(age - 7) < abs(best[0] - 7)):
        best = (age, f)
print(f'/data/history/{best[1]}' if best else '-')
PY
)
echo "format: $kind, compared with: $PREV"

# ---------------------------------------------------------------- assets
# Full-body models and portraits, once per brawler: Supercell's Fan Kit first
# (2026-11-02; the bodies large, from the sources scripts/fankit-sync.py
# records, so a deep zoom stays sharp, and the square icons the site uses),
# else Brawlify. A `.src` file beside each picture says where it came from, so
# a Fan Kit render replaces a Brawlify one already cached. A brawler with no
# model at all (a new one) is drawn as a card, and never quizzed.
docker run -i --rm --user "$(id -u):$(id -g)" -v "$CACHE:/cache" -v "$REPO:/repo:ro" -v "$ROOT/history:/history:ro" \
  -e PYTHONPATH=/cache/py "$PYTHON_IMAGE" python - "/history/$DAY.json" <<'PY'
import io, json, os, re, sys, urllib.error, urllib.parse, urllib.request
from PIL import Image
data = json.load(open(sys.argv[1]))
fk = json.load(open('/repo/src/data/fankit.json'))
icons = json.load(open('/repo/src/data/fankit-icons.json'))
# The wiki's CDN refuses images without a Referer (some drop art is the wiki's).
ua = {'User-Agent': 'BrawlZone (https://brawlzone.net)', 'Referer': 'https://brawlzone.net/'}
def get(url):
    return urllib.request.urlopen(urllib.request.Request(url, headers=ua), timeout=60).read()
def save(img, path, src):
    img.save(path + '.tmp.png'); os.replace(path + '.tmp.png', path)
    open(path[:-4] + '.src', 'w').write(src)
def cached_from(path):
    try: return open(path[:-4] + '.src').read()
    except OSError: return None
# The wiki last (2026-11-03): a brawler released today is on neither the
# Fan Kit nor Brawlify for days, and the "what's new" video skipped Thunder
# Frogs, Rey and Ruby in their own launch week. Its files are "<Name>
# Skin-Default.png" (the render) and "<Name> Portrait.png", looked up through
# the MediaWiki API, the way the site does (lib/wiki-art).
def wiki_file(title):
    q = urllib.parse.urlencode({'action': 'query', 'prop': 'imageinfo', 'titles': f'File:{title}',
                                'iiprop': 'url', 'format': 'json'})
    pages = json.loads(get(f'https://brawlstars.fandom.com/api.php?{q}'))['query']['pages']
    for p in pages.values():
        for i in p.get('imageinfo') or []:
            if i.get('url'): return i['url']
    return None
def wiki_name(name):  # "THUNDER FROGS" -> "Thunder Frogs", "8-BIT" -> "8-Bit"
    return re.sub(r"(^|[ -])([a-z])", lambda m: m.group(1) + m.group(2).upper(), name.lower())
def from_wiki(name, suffix, path):
    url = wiki_file(f"{wiki_name(name)} {suffix}.png")
    if not url: raise LookupError(f'no wiki {suffix}')
    img = Image.open(io.BytesIO(get(url))).convert('RGBA')
    img = img.crop(img.getchannel('A').point(lambda v: 255 if v > 12 else 0).getbbox())
    save(img, path, url)
_seen = {b['id'] for b in data['all']}
for b in data['all'] + [n for n in data.get('newest', []) if n['id'] not in _seen]:
    bid = str(b['id'])
    model, face = f"/cache/models/{bid}.png", f"/cache/faces/{bid}.png"
    src = fk.get('bodySources', {}).get(bid)
    try:
        if src and cached_from(model) != src:
            img = Image.open(io.BytesIO(get(src))).convert('RGBA')
            img = img.crop(img.getchannel('A').point(lambda v: 255 if v > 12 else 0).getbbox())
            img.thumbnail((2000, 2000), Image.LANCZOS)
            save(img, model, src)
        elif not src and not os.path.exists(model):
            try:
                body = get(f"https://cdn.brawlify.com/brawlers/model/{bid}.png")
                open(model, 'wb').write(body)
            except urllib.error.HTTPError:
                from_wiki(b['n'], 'Skin-Default', model)
    except Exception as e:
        print(f"no model for {b['n']}: {e}")
    icon = icons.get(bid)
    try:
        if icon and cached_from(face) != icon:
            save(Image.open('/repo/public' + icon).convert('RGBA').resize((170, 170), Image.LANCZOS), face, icon)
        elif not icon and not os.path.exists(face):
            try:
                body = get(f"https://cdn.brawlify.com/brawlers/borderless/{bid}.png")
                open(face, 'wb').write(body)
            except urllib.error.HTTPError:
                from_wiki(b['n'], 'Portrait', face)
    except Exception as e:
        print(f"no face for {b['n']}: {e}")
# Buffie icons for the "what's new" video, and their newest-first order.
os.makedirs('/cache/buffies', exist_ok=True)
order = {}
for bid, v in fk.get('buffies', {}).items():
    try:
        for kind in ('gadget', 'starPower', 'hyperCharge'):
            path = f'/cache/buffies/{bid}-{kind}.png'
            if cached_from(path) != v[kind]:
                img = Image.open(io.BytesIO(get(v[kind] + '?width=320'))).convert('RGBA')
                img = img.crop(img.getchannel('A').point(lambda a: 255 if a > 12 else 0).getbbox())
                save(img, path, v[kind])
        order[bid] = {'order': v['order']}
    except Exception as e:
        print(f"no buffies for {bid}: {e}")
json.dump(order, open('/cache/buffies/index.json', 'w'))
# Each drop and box's own art for the weekly "1,000 X" Short (make.py drops),
# from the Fan Kit or the wiki as /starr-drops resolves it; the Chaos Drop
# keeps the hand-cached grey one it tints. And the gem icon for its loot.
for slug, d in (data.get('drops') or {}).items():
    src = d.get('image')
    path = f'/cache/drops/{slug}.png'
    if not src or slug == 'chaos-drops' or cached_from(path) == src:
        continue
    try:
        img = Image.open(io.BytesIO(get(src))).convert('RGBA')
        img = img.crop(img.getchannel('A').point(lambda a: 255 if a > 12 else 0).getbbox() or (0, 0, img.width, img.height))
        img.thumbnail((700, 700), Image.LANCZOS)
        save(img, path, src)
    except Exception as e:
        print(f"no art for {slug}: {e}")
# The skin quiz's list of Fan Kit skins (it fetches the five it uses), and the
# ability quiz's icons: every gadget, star power and hypercharge the Fan Kit
# has, named from BrawlAPI, once each.
os.makedirs('/cache/skins', exist_ok=True)
try:
    with open('/repo/scripts/fankit-skin-sources.json') as f:
        open('/cache/skins/sources.json', 'w').write(f.read())
except OSError as e:
    print(f"no skin list: {e}")
os.makedirs('/cache/abilities', exist_ok=True)
abilities = []
try:
    roster = json.loads(get('https://api.brawlapi.com/v1/brawlers'))['list']
    acc, hcs = fk.get('accessories', {}), fk.get('hypercharges', {})
    for r in roster:
        for kind, field in (('gadget', 'gadgets'), ('starPower', 'starPowers')):
            for x in r.get(field) or []:
                if str(x['id']) in acc:
                    abilities.append({'bid': r['id'], 'kind': kind, 'name': x['name'], 'file': f"abilities/{x['id']}.png", 'src': acc[str(x['id'])]})
        if str(r['id']) in hcs:
            abilities.append({'bid': r['id'], 'kind': 'hyperCharge', 'name': None, 'file': f"abilities/hc-{r['id']}.png", 'src': hcs[str(r['id'])]})
except Exception as e:
    print(f"no ability list: {e}")
for a in abilities:
    path = f"/cache/{a['file']}"
    if cached_from(path) == a['src']:
        continue
    try:
        img = Image.open(io.BytesIO(get(a['src'] + '?width=400'))).convert('RGBA')
        img = img.crop(img.getchannel('A').point(lambda v: 255 if v > 12 else 0).getbbox() or (0, 0, img.width, img.height))
        save(img, path, a['src'])
    except Exception as e:
        print(f"no icon for {a['name'] or a['kind']}: {e}")
if abilities:
    json.dump(abilities, open('/cache/abilities/index.json', 'w'))
gem = fk.get('items', {}).get('icongem')
if gem and cached_from('/cache/drops/gems.png') != gem:
    try:
        save(Image.open(io.BytesIO(get(gem + '?width=320'))).convert('RGBA'), '/cache/drops/gems.png', gem)
    except Exception as e:
        print(f"no gem icon: {e}")
PY
[ "$(find "$CACHE/faces" -name '*.png' | wc -l)" -gt 50 ] || die "::error::brawler portraits could not be fetched"
fi  # not newbrawler or daily

# ---------------------------------------------------------------- render
draw () { # kind
  rm -rf "$OUT/frames"
  docker run --rm --user "$(id -u):$(id -g)" -v "$CACHE:/cache" "$PYTHON_IMAGE" sh -c '
    [ -d /cache/py/PIL ] && [ -d /cache/py/numpy ] || pip install -q --disable-pip-version-check --target /cache/py pillow numpy >/dev/null 2>&1' \
    || return 1
  # Two halves of the frames in parallel, one core each: the box has two,
  # and the site keeps serving on whatever they leave.
  local pids=() rc=0 part
  for part in 0 1; do
    docker run --rm --cpus=0.9 --user "$(id -u):$(id -g)" -e ASSETS=/cache -e PART=$part -e PARTS=2 -e TRACK="$TRACK" \
      -v "$REPO/deploy/viral:/code:ro" -v "$CACHE:/cache" -v "$ROOT:/data" -v "$OUT:/out" -w /code \
      "$PYTHON_IMAGE" sh -c "PYTHONPATH=/cache/py python make.py $1 $DATA_IN $PREV /data/state.json /out" \
      > "$CACHE/make-$part.log" 2>&1 &
    pids+=($!)
  done
  for p in "${pids[@]}"; do wait "$p" || rc=$?; done
  return "$rc"
}

draw "$kind"; rc=$?
if [ "$rc" = 3 ] && { [ "$kind" = classrank ] || [ "$kind" = stop ] || [ "$kind" = broken ] || [ "$kind" = ranks ] || [ "$kind" = modes ] || [ "$kind" = giveaway ] || [ "$kind" = drops ] || [ "$kind" = whatsnew ]; }; then
  # The 14:00 slot falls back to the full countdown, which always has data,
  # not to the quiz the 15:30 slot may already be posting today.
  echo "$(tail -n 1 "$CACHE/make-0.log"); drawing everyrank instead"
  kind=everyrank; draw everyrank; rc=$?
elif [ "$rc" = 3 ] && [ "$kind" != quiz ] && [ "$kind" != newbrawler ] && [ "$kind" != daily ] && [ "$kind" != everyrank ]; then
  echo "$(tail -n 1 "$CACHE/make-0.log"); drawing the quiz instead"
  kind=quiz; draw quiz; rc=$?
fi
[ "$rc" = 0 ] || die "::error::make.py $kind failed: $(tail -c 600 "$CACHE/make-0.log") $(tail -c 300 "$CACHE/make-1.log")"

DUR=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["duration"])' "$OUT/meta.json")
frames=$(find "$OUT/frames" -name '*.jpg' | wc -l)
[ "$frames" -gt 100 ] || die "::error::only $frames frames were drawn"

# The cuts are on the beat of $TRACK from its start (tracks.json). The
# fade-out is the last 1.5 seconds; the music's own loudness is left alone.
docker run --rm --user "$(id -u):$(id -g)" -v "$OUT:/w" -v "$(dirname "$MUSIC"):/m:ro" -w /w "$FFMPEG_IMAGE" \
  -hide_banner -loglevel error -y -framerate 30 -i 'frames/%04d.jpg' -ss "$MUSIC_START" -i "/m/$(basename "$MUSIC")" \
  -filter_complex "[1:a]volume=0.9,afade=t=in:d=0.15,afade=t=out:st=$(python3 -c "print(max(0, $DUR - 1.5))"):d=1.5[a]" \
  -map 0:v -map '[a]' -t "$DUR" -c:v libx264 -preset slow -crf 19 -pix_fmt yuv420p -c:a aac -b:a 160k \
  -movflags +faststart video.mp4 \
  || die "::error::ffmpeg could not encode the video"
# The cover TikTok's manifest points at: a frame from the first reveal.
cp "$OUT/frames/$(printf '%04d' $((frames / 4)))".jpg "$OUT/cover.jpg"
rm -rf "$OUT/frames"
rm -f "$OUT"/zoom-*.webp "$OUT/shadow.webp"

# The manifest brawlzone-tiktok reads, and the YouTube titles in Portuguese
# and Spanish (descriptions stay English, like the video).
python3 - "$OUT" "$SITE/social/$FOLDER" <<'PY'
import json, sys
out, url = sys.argv[1], sys.argv[2]
m = json.load(open(f'{out}/meta.json'))
json.dump({'count': 1, 'slides': [f'{url}/cover.jpg'], 'title': m['title'], 'description': m['description']},
          open(f'{out}/slides.json', 'w'), ensure_ascii=False)
json.dump({lang: {'title': t, 'description': m['description']} for lang, t in m.get('titles', {}).items()},
          open(f'{out}/l10n.json', 'w'), ensure_ascii=False)
PY
echo "video: $SITE/social/$FOLDER/video.mp4 ($kind, ${DUR}s)"
[ "$post" = 1 ] || { echo "--no-post: nothing published"; exit 0; }

# ---------------------------------------------------------------- post
# The daily teaser is not posted to YouTube from 2026-11-03: the same
# template every day, it fell from ~1,100 views to 5-24 from 2026-10-31, as
# the counter and map-pick templates did (YouTube treating it as repetitive).
# Instagram keeps it, where it gets more likes than anything else (12-31).
TIKTOK=$([ "$kind" = daily ] && echo 0 || echo 1) \
YOUTUBE=$([ "$kind" = daily ] && echo 0 || echo 1) \
VIDEO_FILE="$OUT/video.mp4" VIDEO_L10N="$OUT/l10n.json" /usr/local/bin/brawlzone-tiktok viral "$FOLDER" \
  || die "::error::brawlzone-tiktok viral failed"

# Posted: remember the episode and the quiz answers, so tomorrow's quiz is
# #N+1 and asks about other brawlers.
python3 - "$ROOT/state.json" "$OUT/meta.json" <<'PY'
import json, os, sys
path, meta = sys.argv[1], json.load(open(sys.argv[2]))
try:
    state = json.load(open(path))
except (OSError, ValueError):
    state = {}
eps = state.setdefault('episodes', {})
eps[meta['kind']] = meta['episode']
if meta.get('used'):
    state['quiz_recent'] = (state.get('quiz_recent', []) + meta['used'])[-60:]
json.dump(state, open(path + '.tmp', 'w')); os.replace(path + '.tmp', path)
