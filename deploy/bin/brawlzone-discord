#!/usr/bin/env bash
# Post the day's meta movement to Discord. Quiet unless something is wrong.
#
# Reuses the `sampler` compose service with the command overridden: it already
# has the database on the compose network, .env.production loaded, and the
# build secret wired up. A second service definition differing only in its
# command would be one more thing to keep in step with the first.
set -uo pipefail

cd /home/ubuntu/brawlstats || exit 1

out=$(mktemp); trap 'rm -f "$out"' EXIT

# No `--build`: the deploy builds the sampler image after every change
# (auto-deploy.sh), so the image is current. It used to build here, which once
# fixed "Missing script: discord:meta" from a stale image, and later raced the
# deploy's build on busy days.
if ! docker compose run --rm sampler npm run discord:meta >"$out" 2>&1; then
  echo "Discord meta post FAILED. Output:"
  # Build noise is a few hundred lines; the useful part is always the tail.
  tail -25 "$out"
  exit 1
fi

# The script prints one line saying what it did, or that nothing moved.
grep -E '^(Posted|Nothing moved)' "$out" || echo "Ran, but said nothing — check the full log."

# Both this and auto-deploy.sh build images, but only auto-deploy pruned. This
# runs every two hours and the deploy only when a commit lands, so on a quiet
# day the build cache grew unchecked -- 6.7GB against a 4GB cap by 2026-09-01,
# which was most of a 8-percentage-point jump in disk use. Same cap, applied
# from both sides.
docker builder prune -f --max-used-space=4GB >/dev/null 2>&1 || true
