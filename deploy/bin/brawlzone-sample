#!/usr/bin/env bash
# Run the stats sampler and report what it did, not how it did it.
#
# The image is built by the deploy (auto-deploy.sh), not here: building on
# every run cost ~5 minutes of the timeout and raced other builds.
#
# `docker compose run` prints a few hundred lines of build progress,
# npm notices and layer hashes. On a successful run none of it is information
# -- the question a log should answer is "did it work and what did it collect",
# and that was buried under image digests.
#
# So: quiet on success, everything on failure. The full output is kept and
# printed only when the exit code is non-zero, which is exactly when someone
# needs it -- and when the OnFailure alert mails this log.
#
# A detached, named container since 2026-10-19. Run in the foreground, a run
# longer than the unit's timeout had only its `docker compose run` client
# killed: the container carried on with nobody reading its output, the log
# showed "Starting sampler" and nothing else, OnFailure mailed a failure for
# a run that went on to succeed, and the next run could start on top of it.
# Runs took 53-98 minutes that day, sharing two cores with deploy builds.
#
# Now the job waits up to WAIT_LIMIT for the container. A run still going then
# is handed off: the job exits cleanly and the container finishes on its own.
# The next job reports that run's result before starting, skips its own turn
# if the run is still going, and stops one stuck for STUCK_AFTER (which does
# fail, and alert).
set -uo pipefail

cd "$HOME/brawlstats" || exit 1
out=$(mktemp)
trap 'rm -f "$out"' EXIT

NAME=brawlzone-sampler-job
WAIT_LIMIT=2700   # 45 minutes, inside the unit's 50
STUCK_AFTER=14400 # 4 hours

report() { # <elapsed seconds>
python3 - "$out" "$1" <<'PY'
import json, re, sys

raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
elapsed = sys.argv[2]

# The script prints one JSON object as its result. Find the last balanced one.
result, depth, start = None, 0, None
for i, ch in enumerate(raw):
    if ch == "{":
        if depth == 0:
            start = i
        depth += 1
    elif ch == "}" and depth:
        depth -= 1
        if depth == 0:
            try:
                candidate = json.loads(raw[start:i + 1])
            except ValueError:
                continue
            if isinstance(candidate, dict) and "playersSampled" in candidate:
                result = candidate

if result is None:
    print(f"Finished in {elapsed}s, but no result was reported -- output kept below.")
    print(raw[-1500:])
    sys.exit(0)

n = lambda k: f"{result.get(k, 0):,}"
print(f"Sampled {n('playersSampled')} players and {n('battlesRecorded')} battles "
      f"across {n('brawlersUpdated')} brawlers")
print(f"Rolled up {n('rolledUp')} rows, pruned {n('pruned')}, "
      f"pool seeded {n('seeded')} and evicted {n('evicted')}")

notes = result.get("notes") or ""
size = re.search(r"db (\d+)MB \((\d+)% of data budget", notes)
if size:
    print(f"Database {size.group(1)} MB, {size.group(2)}% of its budget")
failed = re.search(r"(\d+) of (\d+) player samples failed", notes)
if failed:
    print(f"{failed.group(1)} of {failed.group(2)} player lookups failed "
          f"(deleted or renamed accounts -- normal)")
# Says why the pool shrank. Without this the count just drops by twelve one
# run and nothing on the page accounts for it.
dropped = re.search(r"(\d+) deleted account\(s\) removed from the pool", notes)
if dropped:
    print(f"Dropped {dropped.group(1)} of them from the pool for good; "
          f"fresh players take those slots next run")

status = result.get("status", "?")
print(f"Status {status}, completed in {elapsed}s")
PY
}

# Collects a finished container: its output into $out, its exit code echoed.
collect() {
  docker logs "$NAME" >"$out" 2>&1
  local rc
  rc=$(docker inspect -f '{{.State.ExitCode}}' "$NAME" 2>/dev/null || echo 1)
  docker rm "$NAME" >/dev/null 2>&1
  echo "$rc"
}

age_of() { # seconds since the container's StartedAt
  local started
  started=$(docker inspect -f '{{.State.StartedAt}}' "$NAME" 2>/dev/null) || { echo 0; return; }
  echo $(( $(date +%s) - $(date -d "$started" +%s) ))
}

# 1. A previous run, still going or finished after its job had handed off.
status=$(docker inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || true)
if [ "$status" = running ]; then
  age=$(age_of)
  if [ "$age" -lt "$STUCK_AFTER" ]; then
    echo "The previous run is still going ($((age / 60)) min); skipping this turn"
    exit 0
  fi
  echo "The previous run has been going $((age / 60)) min; stopping it as stuck. Its last output:"
  docker stop -t 60 "$NAME" >/dev/null 2>&1
  collect >/dev/null
  tail -c 3000 "$out"
  exit 1
elif [ -n "$status" ]; then
  finished=$(docker inspect -f '{{.State.FinishedAt}}' "$NAME")
  took=$(( $(date -d "$finished" +%s) - $(date -d "$(docker inspect -f '{{.State.StartedAt}}' "$NAME")" +%s) ))
  rc=$(collect)
  echo "The previous run finished after its hand-off, at $finished (exit $rc):"
  if [ "$rc" -ne 0 ]; then tail -c 3000 "$out"; else report "$took"; fi
  echo
fi

# 2. This run -- unless the disk is nearly full.
#    Each run grows Postgres by ~100 MB, and Postgres is what dies when the disk
#    fills (2026-09-09: five hours of "not enough data"). The health check
#    clears space from 70% and harder from 85%; if the disk is still at
#    DISK_STOP after that, missing a run is far cheaper than a dead database.
DISK_STOP=92
use=$(df --output=pcent / | tail -1 | tr -dc '0-9')
if [ "$use" -ge "$DISK_STOP" ]; then
  echo "Disk at ${use}% (limit ${DISK_STOP}%); not sampling this turn so the database cannot fill it"
  df -h / | tail -1
  exit 1
fi

echo "Starting sampler"
start=$(date +%s)
if ! docker compose run -d --name "$NAME" sampler >"$out" 2>&1; then
  echo "Could not start the sampler container:"
  cat "$out"
  exit 1
fi
while [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ]; do
  if [ $(( $(date +%s) - start )) -ge "$WAIT_LIMIT" ]; then
    echo "Still running after $((WAIT_LIMIT / 60)) minutes; handed off to finish on its own. The next run reports its result."
    exit 0
  fi
  sleep 15
done
elapsed=$(( $(date +%s) - start ))
rc=$(collect)

if [ "$rc" -ne 0 ]; then
  echo "Sampler FAILED after ${elapsed}s (exit $rc). Full output follows:"
  cat "$out"
  exit "$rc"
fi

report "$elapsed"

# Both this and auto-deploy.sh build images, but only auto-deploy pruned. This
# runs every two hours and the deploy only when a commit lands, so on a quiet
# day the build cache grew unchecked -- 6.7GB against a 4GB cap by 2026-09-01,
# which was most of a 8-percentage-point jump in disk use. Same cap, applied
# from both sides.
docker builder prune -f --max-used-space=4GB >/dev/null 2>&1 || true
