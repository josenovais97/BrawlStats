#!/usr/bin/env bash
# Send one of the day's carousels to TikTok as a draft.
#
#   brawlzone-tiktok [daily|build] [YYYY-MM-DD]
#
# Two posts a day, one script. `daily` is the findings carousel; `build` is one
# brawler's star power, gadget and gear split. They differ only in which
# manifest they read, so they share the token handling -- which matters more
# than it looks: TikTok rotates the refresh token on every use, and two scripts
# with their own copies of that logic would race on the same state file and
# lock the integration out. The timers are scheduled hours apart for the same
# reason.
#
# The site renders each carousel under /daily/<date>/ and this pushes the whole
# set to the account's inbox with post_mode=MEDIA_UPLOAD. TikTok then notifies the phone;
# the account holder opens it, adds music and a caption in TikTok's own editor,
# and decides whether to publish. Nothing here posts publicly.
#
# DIRECT_POST is the eventual goal and is one constant away — but an unaudited
# client has its posts forced to private whatever it asks for, so automating it
# before the audit passes would automate invisible posts. See POST_MODE below.
#
# WHY THIS RUNS ON THE BOX and not in the app: TikTok rotates the refresh token
# on every use, so whatever holds it has to write the new one back. The app
# container is rebuilt on every deploy and its filesystem goes with it. The
# state file here is outside the repo for the same reason.
set -uo pipefail

STATE="${HOME}/.brawlzone-tiktok.json"
ENV_FILE="/home/ubuntu/brawlstats/.env.production"
SITE="https://brawlzone.net"
TOKEN_URL="https://open.tiktokapis.com/v2/oauth/token/"
INIT_URL="https://open.tiktokapis.com/v2/post/publish/content/init/"
STATUS_URL="https://open.tiktokapis.com/v2/post/publish/status/fetch/"

# MEDIA_UPLOAD until the audit passes; DIRECT_POST after. Nothing else in this
# script changes when it flips — the request body already carries a title and a
# description, which both modes accept.
POST_MODE="MEDIA_UPLOAD"

die() { echo "$*" >&2; exit 1; }

# Write a timestamp into the state file, merging rather than replacing.
#
# Health check 11 reads these. A timer that stops firing never fails, so
# OnFailure cannot see it, and the daily mail is now the prompt to go and
# publish -- which makes silence ambiguous: it means either "nothing to post"
# or "the job is dead", and an inbox cannot tell you which. Writing down when
# the job last ran, and separately when it last actually posted, is what lets
# the box answer that instead of you guessing.
record_state () { # dotted key, value
  python3 - "$STATE" "$1" "$2" <<'PY'
import json, sys
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
state = json.load(open(path))
section, name = key.split('.', 1)
state.setdefault(section, {})[name] = value
with open(path, 'w') as f:
    json.dump(state, f, indent=2)
PY
}

now_iso () { date -u +%Y-%m-%dT%H:%M:%S+00:00; }

[ -f "$ENV_FILE" ] || die "::error::no $ENV_FILE"
CLIENT_KEY=$(grep -oP '^TIKTOK_CLIENT_KEY=\K.*' "$ENV_FILE" | tr -d '"')
CLIENT_SECRET=$(grep -oP '^TIKTOK_CLIENT_SECRET=\K.*' "$ENV_FILE" | tr -d '"')
[ -n "${CLIENT_KEY:-}" ] || die "::error::TIKTOK_CLIENT_KEY missing from $ENV_FILE"
[ -n "${CLIENT_SECRET:-}" ] || die "::error::TIKTOK_CLIENT_SECRET missing from $ENV_FILE"

[ -f "$STATE" ] || die "::error::no $STATE — authorise once at ${SITE}/api/tiktok/auth?key=\$TIKTOK_SETUP_KEY"
REFRESH=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("refresh_token",""))' "$STATE")
[ -n "$REFRESH" ] || die "::error::$STATE has no refresh_token"

# ----------------------------------------------------------------- the token
#
# Access tokens last 24 hours, so one is fetched per run rather than stored.
# The refresh token that comes back REPLACES the one used, and is written
# before anything else happens: a post that fails is a day missed, but a
# rotated token that was never saved locks the integration out until somebody
# authorises by hand.
token_json=$(curl -s --max-time 30 -X POST "$TOKEN_URL" \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "client_key=${CLIENT_KEY}" \
  --data-urlencode "client_secret=${CLIENT_SECRET}" \
  --data-urlencode "grant_type=refresh_token" \
  --data-urlencode "refresh_token=${REFRESH}")

ACCESS=$(printf '%s' "$token_json" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("access_token",""))' 2>/dev/null)
if [ -z "$ACCESS" ]; then
  die "::error::token refresh failed: $(printf '%s' "$token_json" | head -c 300)"
fi

# The JSON travels in argv, not on stdin: `python3 -` reads its PROGRAM from
# stdin, so a heredoc and a pipe cannot both feed it. Piping here silently fed
# python an empty document and dropped the rotated token.
python3 - "$STATE" "$token_json" <<'PY'
import json, sys, datetime
state_path = sys.argv[1]
fresh = json.loads(sys.argv[2])
state = json.load(open(state_path))
# Only overwrite when a new one actually came back. TikTok returns the same
# token when it is not due for rotation, and an empty field must never clear
# the one that works.
if fresh.get('refresh_token'):
    state['refresh_token'] = fresh['refresh_token']
if fresh.get('open_id'):
    state['open_id'] = fresh['open_id']
state['refreshed_at'] = datetime.datetime.now(datetime.UTC).isoformat()
with open(state_path, 'w') as f:
    json.dump(state, f, indent=2)
PY
saved=$?
# The echo below used to run unconditionally, which is precisely how the
# dropped-token bug stayed invisible: the save threw and the log still said
# "token refreshed". A token that was not persisted is a lockout, so abort
# rather than post and carry on.
[ "$saved" -eq 0 ] || die "::error::could not save the rotated refresh token to $STATE"
echo "token refreshed"

# ---------------------------------------------------------------- the post
MODE="${1:-daily}"
DAY="${2:-$(date -u +%Y-%m-%d)}"

case "$MODE" in
  daily) MANIFEST="${SITE}/daily/${DAY}/slides.json" ;;
  build) MANIFEST="${SITE}/daily/${DAY}/build/slides.json" ;;
  *)     die "::error::unknown mode '${MODE}' (expected daily or build)" ;;
esac

# Before anything that can exit, so "the job ran and decided there was nothing
# to post" stays distinguishable from "the job never ran at all". Those two
# look identical from the inbox and need different fixes.
record_state "last_run.${MODE}" "$(now_iso)" || true

# A carousel, not one image, and the site publishes the list rather than this
# job guessing: the slide count varies with the day's content, and re-deriving
# it here would be a second implementation that drifts the first time either
# carousel changes shape. The caption comes down the same way, for the same
# reason -- it is made of the same numbers the slides draw.
manifest_json=$(curl -s --max-time 120 "$MANIFEST")

# An empty slide list is a valid answer, not a failure: the build rotation
# skips brawlers whose split is too thin to post, and a day can legitimately
# have nothing worth saying. Exiting 0 keeps that from paging anybody.
count=$(printf '%s' "$manifest_json" | python3 -c '
import json, sys
try:
    print(int(json.load(sys.stdin).get("count", 0)))
except Exception:
    print(-1)
' 2>/dev/null)
if [ "${count:--1}" = "0" ]; then
  echo "nothing to post for ${MODE} on ${DAY}"
  exit 0
fi
[ "${count:--1}" != "-1" ] || die "::error::unreadable manifest at $MANIFEST: $(printf "%s" "$manifest_json" | head -c 200)"

SLIDES=$(printf '%s' "$manifest_json" | python3 -c '
import json, sys
for url in json.load(sys.stdin).get("slides", []):
    print(url)
' 2>/dev/null)
[ -n "$SLIDES" ] || die "::error::no slides listed at $MANIFEST: $(printf "%s" "$manifest_json" | head -c 200)"

# Each slide must be fetchable before TikTok is asked to fetch it: a 404 there
# returns a generic error from their side that says nothing about why.
#
# These requests are not health checks, they are the renders. Nothing touches a
# day's slides before this job does, so the first fetch of each queries the
# findings, pulls brawler art and rasterises a 1080x1920 image on two shared
# cores -- the most expensive requests the box serves all day, and 60s was not
# enough for one of them on 2026-09-25. Hence a real budget and one retry: a
# cold render that overran once leaves a warm ISR entry for the second try.
slide_count=0
while IFS= read -r slide; do
  [ -n "$slide" ] || continue
  slide_count=$((slide_count + 1))
  code=''
  for attempt in 1 2; do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 240 "$slide")
    [ "$code" = "200" ] && break
    [ "$attempt" = "1" ] && echo "::warning::${slide} returned ${code:-000}, retrying once"
  done
  [ "$code" = "200" ] || die "::error::slide not available at $slide (HTTP ${code:-000})"
done <<< "$SLIDES"
echo "${slide_count} slides ready"

# The caption comes from the manifest, which built it out of the same numbers
# the slides draw. It used to be reassembled here from the RSS feed, which
# meant two implementations of one claim -- and the bash half got it wrong
# twice: `read` split the title on spaces, and the description repeated the
# first finding that TikTok already renders above it.
#
# The numbers belong in the caption as well as on the images because TikTok
# indexes caption text and does not read pictures.
IFS=$'\t' read -r TITLE DESCRIPTION < <(
  printf '%s' "$manifest_json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
title = (d.get("title") or "What the Brawl Stars data says today")[:90]
desc = (d.get("description") or "Measured from sampled Brawl Stars battles.")[:3900]
print(title.replace("\t", " ") + "\t" + desc.replace("\t", " "))
'
)
[ -n "$TITLE" ] || die "::error::manifest carried no caption"

payload=$(python3 - "$TITLE" "$DESCRIPTION" "$SLIDES" "$POST_MODE" <<'PY'
import json, sys
title, description, slides, mode = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
images = [line for line in slides.splitlines() if line.strip()]
body = {
    'post_info': {'title': title, 'description': description},
    'source_info': {
        'source': 'PULL_FROM_URL',
        # Slide 0 is the cover by construction -- the one laid out to be read
        # at thumbnail size, which is all most people ever see of a post.
        'photo_cover_index': 0,
        'photo_images': images,
    },
    'post_mode': mode,
    'media_type': 'PHOTO',
}
print(json.dumps(body))
PY
)

response=$(curl -s --max-time 60 -X POST "$INIT_URL" \
  -H "Authorization: Bearer ${ACCESS}" \
  -H 'Content-Type: application/json; charset=UTF-8' \
  --data-raw "$payload")

PUBLISH_ID=$(printf '%s' "$response" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("data",{}).get("publish_id",""))' 2>/dev/null)
ERR=$(printf '%s' "$response" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("error",{}).get("code",""))' 2>/dev/null)

if [ -z "$PUBLISH_ID" ] || { [ -n "$ERR" ] && [ "$ERR" != "ok" ]; }; then
  # Named rather than generic, because these three are the ones that will
  # actually happen and each has a different fix.
  case "$ERR" in
    url_ownership_unverified)
      die "::error::TikTok refuses the slide URLs: brawlzone.net is not verified for this app any more." ;;
    spam_risk_too_many_pending_share)
      echo "::warning::TikTok has 5 uploads already waiting in the inbox; skipping today rather than stacking another."
      exit 0 ;;
    unaudited_client_can_only_post_to_private_accounts)
      die "::error::POST_MODE is DIRECT_POST but the app is not audited. Set it back to MEDIA_UPLOAD." ;;
    *)
      die "::error::TikTok refused the upload: $(printf '%s' "$response" | head -c 400)" ;;
  esac
fi

record_state "last_post.${MODE}" "$(now_iso)" || true
echo "uploaded ${DAY} as ${PUBLISH_ID}"

# Status is informational: the upload is already accepted, and TikTok processes
# it asynchronously. Worth printing so a failure that happens after acceptance
# is visible in the log rather than silent.
sleep 5
status=$(curl -s --max-time 30 -X POST "$STATUS_URL" \
  -H "Authorization: Bearer ${ACCESS}" \
  -H 'Content-Type: application/json; charset=UTF-8' \
  --data-raw "{\"publish_id\":\"${PUBLISH_ID}\"}")
read -r STATUS FAIL_REASON < <(
  printf '%s' "$status" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin).get("data", {})
except Exception:
    d = {}
print((d.get("status") or "?"), (d.get("fail_reason") or "-"))
' 2>/dev/null
)
echo "status: ${STATUS:-?} ${FAIL_REASON:--}"

# ------------------------------------------------------------------- the mail
#
# MEDIA_UPLOAD only puts the carousel in the inbox; somebody still has to open
# TikTok and publish it. Without a nudge that means remembering, every day, to
# go and look -- and a day nobody looks is a day the post silently does not
# happen, which is indistinguishable from the job being broken.
#
# Uses the same alerter as everything else on the box rather than a second mail
# path: one msmtp config, one ALERT_TO, one place to fix. brawlzone-alert exits
# 0 even when mail fails, deliberately, so this cannot turn a successful post
# into a failed unit.
#
# No <img> of the card: mail clients block remote images by default, so an
# email whose whole content is a blocked image says nothing. The findings go in
# as text, which is also what makes the mail skimmable on a phone.
HTML_LIB=/usr/local/lib/brawlzone-html.sh
if [ -x /usr/local/bin/brawlzone-alert ] && [ -r "$HTML_LIB" ]; then
  # shellcheck disable=SC1090
  . "$HTML_LIB"

  if [ "$POST_MODE" = "DIRECT_POST" ]; then
    subject="[brawlzone] Posted to TikTok (${MODE}) -- ${DAY}"
    heading="Posted to TikTok"
    todo="Nothing to do. DIRECT_POST published it; this is a record, not a prompt."
    accent="$OK"
  else
    subject="[brawlzone] TikTok ${MODE} carousel waiting -- ${DAY}"
    heading="Waiting in your TikTok inbox"
    todo="Open TikTok, tap the notification, add music if you want it, and publish."
    accent="$ACCENT"
  fi

  {
    html_open "$heading" "${DAY} &middot; ${slide_count} slides" "$accent"

    html_section "The post"
    html_rows_open
    html_row "Title" "$(printf '%s' "$TITLE" | esc)"
    html_row "Slides" "$slide_count"
    html_row "Post" "$MODE"
    html_row "Mode" "$POST_MODE"
    html_row "Status" "${STATUS:-?}" "$([ "${FAIL_REASON:--}" = "-" ] && printf '%s' "$OK" || printf '%s' "$BAD")"
    [ "${FAIL_REASON:--}" = "-" ] || html_row "Fail reason" "$(printf '%s' "$FAIL_REASON" | esc)" "$BAD"
    html_row "Findings page" "<a href=\"${SITE}/daily/${DAY}\" style=\"color:${ACCENT};\">/daily/${DAY}</a>"
    html_rows_close

    html_section "Caption"
    printf '%s\n' "$DESCRIPTION" | html_pre

    html_section "What to do"
    printf '%s\n' "$todo" | html_pre

    html_close "brawlzone-web &middot; sent by brawlzone-tiktok after a successful upload.<br>Publish id ${PUBLISH_ID}"
  } | /usr/local/bin/brawlzone-alert --html "$subject"
  echo "notified"
else
  echo "::warning::no brawlzone-alert on this host; skipping the email"
fi
