// Neon Postgres, provisioned through the Vercel Marketplace integration.
// See the README for setup and migration steps.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts for migrations and
// from the driver adapter at runtime, so no `url` belongs here.
datasource db {
  provider = "postgresql"
}

/// The rotating pool of player tags the sampler walks through.
///
/// Seeded from global/regional trophy rankings and from the clubs those
/// players belong to, plus anyone looked up on the site. `lastSampledAt`
/// drives a least-recently-sampled queue so one cron run never re-reads the
/// same players.
model SampledPlayer {
  tag           String    @id
  name          String?
  trophies      Int?
  /// Where the tag came from: "ranking", "club", "lookup".
  source        String    @default("ranking")
  /// Equipped profile icon, the only cosmetic the player payload reports at
  /// account level. Recorded so icon popularity can be ranked; null on rows
  /// written before this was tracked.
  iconId        Int?      @map("icon_id")

  /// Ranked standing at the last sample.
  ///
  /// The game API publishes trophy leaderboards but no Ranked one — there is no
  /// endpoint that returns the top players by elo. Recording it per sample is
  /// the only way to have that board at all, so it ranks our sampled pool
  /// rather than the world, and the page says so.
  rankedElo             Int?    @map("ranked_elo")
  rankedRankName        String? @map("ranked_rank_name")
  highestRankedElo      Int?    @map("highest_ranked_elo")
  highestRankedRankName String? @map("highest_ranked_rank_name")
  lastSampledAt DateTime? @map("last_sampled_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([lastSampledAt])
  /// Drives the Ranked board.
  @@index([highestRankedElo])
  @@map("sampled_players")
}

/// One row per (player, brawler, day), for a rotating quarter of the sampled
/// players: the trophy and rank distribution that feeds avg trophies and rank
/// counts.
///
/// A sample, not a census, and that word is doing real work. Written for every
/// sampled player it reached 192.6 MB — 47% of a 400 MB database — while every
/// consumer of it is an aggregate over the population: mean trophies and rank
/// per brawler, the share of owners holding each ability, skin and icon
/// popularity. None of those need every player, and paying half the plan for
/// precision below the width of what is being measured is the wrong trade.
///
/// `SNAPSHOT_SAMPLE_RATE` in lib/aggregation picks who is recorded, rotating
/// the cohort daily so the aggregates are not measured on a fixed panel.
/// Battles are unaffected — every sampled player's log is still read in full,
/// because that is what the tier lists are actually built from.
model PlayerBrawlerSnapshot {
  id           Int      @id @default(autoincrement())
  playerTag    String   @map("player_tag")
  brawlerId    Int      @map("brawler_id")
  brawlerName  String   @map("brawler_name")
  trophies     Int
  highestTroph Int      @map("highest_trophies")
  rank         Int
  power        Int

  /// Which abilities this player owns on this brawler. The API never reports
  /// what is *equipped*, so ownership is the only available signal for which
  /// options players actually invest in.
  starPowerIds Int[]    @map("star_power_ids")
  gadgetIds    Int[]    @map("gadget_ids")
  gearIds      Int[]    @map("gear_ids")
  /// Hypercharges owned. Recorded late, so rows written before this exist with
  /// an empty array — which is indistinguishable from "owns none". Reads guard
  /// against that by ignoring brawlers where *nobody* has one recorded.
  hyperChargeIds Int[]  @map("hyper_charge_ids")

  /// Buffies owned, as three flags. Used to derive which buffies exist at all,
  /// since the API publishes no buffie catalogue.
  buffieGadget      Boolean @default(false) @map("buffie_gadget")
  buffieStarPower   Boolean @default(false) @map("buffie_star_power")
  buffieHyperCharge Boolean @default(false) @map("buffie_hyper_charge")

  /// The skin equipped on this brawler on this day.
  ///
  /// The API reports only what is *equipped*, never what is owned, so a single
  /// read cannot answer "which skins does this player have". Recording it daily
  /// turns that into a question the data can answer over time: the union across
  /// snapshots is skins seen, and the distribution across players is which
  /// skins people actually use. Null on rows written before this was tracked,
  /// which can never be backfilled.
  skinId       Int?     @map("skin_id")
  skinName     String?  @map("skin_name")

  snapshotDate DateTime @map("snapshot_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([playerTag, brawlerId, snapshotDate])
  @@index([snapshotDate, brawlerId])
  /// Drives the skin popularity board.
  @@index([snapshotDate, skinId])
  @@map("player_brawler_snapshots")
}

/// One row per battle *as played by a sampled player*, recording which brawler
/// they used and how it went.
///
/// Only the sampled player's own entry is stored, never their teammates' —
/// counting every participant would inflate the sample with correlated rows
/// and skew usage toward whatever the sampled cohort tends to face.
model BattleSample {
  id          Int      @id @default(autoincrement())
  /// "<battleTime>:<playerTag>" — the natural key that makes re-runs idempotent.
  battleKey   String   @unique @map("battle_key")
  playerTag   String   @map("player_tag")
  brawlerId   Int      @map("brawler_id")
  brawlerName String   @map("brawler_name")
  /// "victory" | "defeat" | "draw"
  result      String
  /// Showdown placement when the mode reports a rank instead of a result.
  rank        Int?
  mode        String
  /// Map name from the battle's event. Null on rows sampled before map
  /// recording was added, and on battles the API reports without an event.
  mapName     String?  @map("map_name")
  /// Brawlify event id for the map, for artwork lookups.
  eventId     Int?     @map("event_id")
  battleType  String   @map("battle_type")
  trophyChange Int?    @map("trophy_change")
  battleTime  DateTime @map("battle_time")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([battleTime])
  @@index([brawlerId, battleTime])
  /// Drives the per-map ranked tier list.
  @@index([battleType, mapName, battleTime])
  @@map("battle_samples")
}

/// One row per sampled 3v3 battle, recording who the sampled player's brawler
/// stood beside and who it stood against.
///
/// Deliberately separate from `BattleSample`, and never read by anything that
/// computes usage or win rates. The reason `BattleSample` stores only the
/// sampled player's own entry is that counting every participant inflates the
/// sample with correlated rows and skews usage toward whatever the cohort
/// happens to face — that objection still stands, and this table does not
/// change it. Matchups are a different question ("how does Shelly do *against*
/// Colt"), and it is the only question this table answers.
///
/// Both id lists are from the sampled player's perspective: `result` is their
/// team's, so an enemy brawler in a row with result "victory" is one this
/// brawler beat. Free-for-all modes are skipped entirely — there are no teams
/// to take sides of, and a showdown placement is not a matchup.
model BattleTeamSample {
  id          Int      @id @default(autoincrement())
  /// Same natural key as `battle_samples`, so re-runs are idempotent.
  battleKey   String   @unique @map("battle_key")
  playerTag   String   @map("player_tag")
  /// The sampled player's brawler: the subject of every pairing in this row.
  brawlerId   Int      @map("brawler_id")
  /// "victory" | "defeat" | "draw", from the sampled player's side.
  result      String
  mode        String
  mapName     String?  @map("map_name")
  battleType  String   @map("battle_type")
  /// Team-mates' brawlers, excluding the subject.
  allyBrawlerIds  Int[] @map("ally_brawler_ids")
  /// Every brawler on the opposing team(s).
  enemyBrawlerIds Int[] @map("enemy_brawler_ids")
  battleTime  DateTime @map("battle_time")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([brawlerId, battleTime])
  @@index([battleTime])
  @@map("battle_team_samples")
}

/// One trophy reading per player per day, appended whenever a profile is viewed.
///
/// `sampled_players.trophies` is overwritten on every lookup, so it can only
/// ever answer "how many now" — a player who visits weekly leaves no trace of
/// having moved. This table is the history behind that number.
///
/// Keyed by day rather than by lookup on purpose: a profile refreshed forty
/// times in an afternoon should not write forty rows, and a chart wants one
/// point per day anyway. The last reading of a day wins, so a row is the
/// player's standing at the end of that day.
///
/// Unlike `player_brawler_snapshots`, which only covers the sampled pool, this
/// fills in for anyone who is ever looked up.
model PlayerTrophyPoint {
  id              Int      @id @default(autoincrement())
  playerTag       String   @map("player_tag")
  recordedOn      DateTime @map("recorded_on") @db.Date
  trophies        Int
  highestTrophies Int      @map("highest_trophies")
  /// Brawlers unlocked at the time, so the curve can be read against roster size.
  brawlerCount    Int      @map("brawler_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([playerTag, recordedOn])
  @@index([playerTag, recordedOn])
  @@map("player_trophy_points")
}

/// Daily aggregate the tier list reads. Recomputed by the cron job from the
/// trailing sampling window, never queried live from the game API.
model BrawlerStat {
  id           Int      @id @default(autoincrement())
  brawlerId    Int      @map("brawler_id")
  brawlerName  String   @map("brawler_name")
  snapshotDate DateTime @map("snapshot_date") @db.Date

  /// Fraction 0–1 of decided sampled battles with this brawler that were wins.
  winRate     Float? @map("win_rate")
  /// Mean win rate across the entire sample on this snapshot.
  ///
  /// The pool skews toward strong players, who win most games regardless of
  /// brawler, so raw win rate sits far above 50%. Tiers are assigned on the
  /// gap between `winRate` and this baseline, which cancels that bias out.
  baselineWinRate Float? @map("baseline_win_rate")
  /// Fraction 0–1 of all sampled battles that featured this brawler.
  usageRate   Float? @map("usage_rate")
  /// Mean trophies across sampled players who own this brawler.
  avgTrophies Float? @map("avg_trophies")
  /// Mean brawler rank across the same population.
  avgRank     Float? @map("avg_rank")

  /// Battles counted for usageRate (includes showdown placements).
  sampleSize      Int @default(0) @map("sample_size")
  /// Competitive battles that reported a win or loss: the denominator behind
  /// winRate. Ladder battles count toward sampleSize but not this.
  decidedSampleSize Int @default(0) @map("decided_sample_size")
  /// Player-brawler snapshots counted for avgTrophies/avgRank.
  ownerSampleSize Int @default(0) @map("owner_sample_size")
  /// Number of days of battle data folded into this row.
  windowDays      Int @default(7) @map("window_days")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([brawlerId, snapshotDate])
  @@index([snapshotDate])
  @@map("brawler_stats")
}

/// Daily snapshot of the official brawler catalogue.
///
/// There is no patch-notes API, so the "what changed in the game" feed is
/// built by diffing this table against yesterday: a new brawler id, a new star
/// power, a hypercharge appearing on an existing brawler. It records what the
/// game API exposes, which is roster and kit changes — not balance numbers.
model BrawlerCatalogEntry {
  id             Int      @id @default(autoincrement())
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  brawlerId      Int      @map("brawler_id")
  brawlerName    String   @map("brawler_name")
  starPowerIds   Int[]    @map("star_power_ids")
  gadgetIds      Int[]    @map("gadget_ids")
  gearIds        Int[]    @map("gear_ids")
  hyperChargeIds Int[]    @map("hyper_charge_ids")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([brawlerId, snapshotDate])
  @@index([snapshotDate])
  @@map("brawler_catalog_entries")
}

/// A single detected change between two catalogue snapshots.
model CatalogChange {
  id          Int      @id @default(autoincrement())
  detectedOn  DateTime @map("detected_on") @db.Date
  /// "brawlerAdded" | "starPowerAdded" | "gadgetAdded" | "hyperchargeAdded"
  /// | "gearAdded" | "brawlerRemoved" | "abilityRemoved"
  kind        String
  brawlerId   Int      @map("brawler_id")
  brawlerName String   @map("brawler_name")
  itemId      Int?     @map("item_id")
  itemName    String?  @map("item_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([detectedOn, kind, brawlerId, itemId])
  @@index([detectedOn])
  @@map("catalog_changes")
}

/// Cached global top-200 for each brawler.
///
/// The rankings endpoint caps at 200 entries and would cost one call per
/// brawler per lookup, so the cron job caches the whole board daily. A profile
/// page then resolves every placement a player holds with a single indexed
/// query instead of ~106 API calls.
model BrawlerRankingEntry {
  id          Int      @id @default(autoincrement())
  brawlerId   Int      @map("brawler_id")
  brawlerName String   @map("brawler_name")
  region      String   @default("global")
  rank        Int
  playerTag   String   @map("player_tag")
  playerName  String   @map("player_name")
  trophies    Int
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@unique([brawlerId, region, rank])
  @@index([playerTag])
  @@map("brawler_ranking_entries")
}

/// Aggregated ability-ownership rates per brawler, powering popular builds.
model BrawlerBuildStat {
  id           Int      @id @default(autoincrement())
  brawlerId    Int      @map("brawler_id")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  /// "starPower" | "gadget" | "gear"
  kind         String
  itemId       Int      @map("item_id")
  /// Sampled owners of this brawler who have this specific ability.
  owners       Int
  /// Sampled owners of the brawler overall, i.e. the denominator.
  totalOwners  Int      @map("total_owners")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([brawlerId, snapshotDate, kind, itemId])
  @@index([snapshotDate])
  @@map("brawler_build_stats")
}

/// Audit trail for cron runs, so a stale tier list can be explained.
model AggregationRun {
  id              Int      @id @default(autoincrement())
  startedAt       DateTime @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  playersSampled  Int      @default(0) @map("players_sampled")
  battlesRecorded Int      @default(0) @map("battles_recorded")
  brawlersUpdated Int      @default(0) @map("brawlers_updated")
  /// "ok" | "partial" | "failed"
  status          String   @default("ok")
  notes           String?

  @@map("aggregation_runs")
}

/* -------------------------------------------------------------------------- */
/*                              daily roll-ups                                */
/* -------------------------------------------------------------------------- */

/*
 * Why these four tables exist.
 *
 * `battle_samples` and `battle_team_samples` are written once and then only
 * ever read in aggregate: every query against them is a `groupBy` or a
 * `COUNT`, and not one of them opens an individual row. They were nonetheless
 * kept for 24 days, because the per-map ranked tier list reads a 21-day
 * window — so the database was storing three weeks of per-battle detail purely
 * to answer questions about counts.
 *
 * That was affordable when the sampler was slower. Measured on 2026-08-24 the
 * rate had roughly quadrupled inside a week (15k battles/day on the 17th, 55k
 * by the 23rd), and the old windows projected to ~990 MB against a 512 MB
 * ceiling — a wall roughly three weeks out that no amount of pruning could
 * move, because 21 days of raw battles is ~430 MB on its own and the 21 days
 * are what the site's main feature reads.
 *
 * So the window and the detail were separated. These tables hold one row per
 * distinct *combination* per day instead of one row per battle, which on real
 * data is 6.5x fewer rows (52,763 battles -> 8,036 groups) and far narrower
 * ones: no 30-character battle key, no player tag, no trophy delta. The raw
 * tables now live just long enough to be rolled up and to survive a couple of
 * failed runs; the roll-ups carry the long window at roughly a twentieth of
 * the size, and their cost is flat in time rather than growing with it.
 *
 * Roll-ups are rebuilt per day rather than upserted, matching `brawler_stats`:
 * a day is deleted and re-inserted from the raw rows in one statement, which
 * is idempotent and sidesteps the fact that `map_name` and `event_id` are
 * nullable and so cannot carry a useful unique constraint.
 */

/// Daily roll-up of `battle_samples`: the grain every usage and win-rate read
/// actually groups by.
///
/// `rank` is kept because showdown placements are folded into wins and losses
/// at read time, and `brawlerName` because the reads project it without
/// joining a catalogue. `lastBattleTime` preserves the one non-count aggregate
/// any caller asked for — `getRankedMapTiers` uses `MAX(battleTime)` to tell a
/// map still in rotation from a map merely still inside the window.
model BattleDailyStat {
  id             Int      @id @default(autoincrement())
  day            DateTime @db.Date
  battleType     String   @map("battle_type")
  mode           String
  mapName        String?  @map("map_name")
  eventId        Int?     @map("event_id")
  brawlerId      Int      @map("brawler_id")
  brawlerName    String   @map("brawler_name")
  /// "victory" | "defeat" | "draw"
  result         String
  /// Showdown placement; null for every mode that reports a result.
  rank           Int?
  /// Battles in this combination on this day.
  battles        Int
  /// Newest battle folded into this row, for rotation freshness.
  lastBattleTime DateTime @map("last_battle_time")

  @@index([day, battleType])
  @@map("battle_daily_stats")
}

/// Daily roll-up of `battle_samples` keyed by player, which is the only thing
/// the raw table was still needed for.
///
/// Two callers care who played, not just what: `evictStalePool` ranks pool
/// members by battles produced over `INACTIVE_AFTER_DAYS`, and
/// `getBrawlerAbilityChoices` joins a player's owned abilities to how that
/// player actually performed on the brawler. Both want counts per player, and
/// at ~13k (player, brawler) pairs a day this answers them for about a
/// twentieth of what keeping the battles themselves would cost — which is what
/// lets the raw window shrink to days without shortening either feature's
/// window.
model PlayerBattleDaily {
  day                DateTime @db.Date
  playerTag          String   @map("player_tag")
  brawlerId          Int      @map("brawler_id")
  /// Every battle, matching the pick-rate denominator.
  battles            Int
  /// Of those, the ones in COMPETITIVE_BATTLE_TYPES.
  competitiveBattles Int      @map("competitive_battles")
  wins               Int
  /// Battles that reported a win or a loss, i.e. the win-rate denominator.
  decided            Int

  /*
   * The natural key *is* the key. A surrogate id would add four bytes a row
   * plus a whole index that nothing looks anything up by — these rows are
   * derived, rebuilt per day, and never referenced from anywhere else.
   *
   * Ordered day-first so the prune and the pool-eviction scan, which both
   * filter on a day range and nothing else, ride the primary key. The one read
   * that starts from a brawler gets the index below.
   */
  @@id([day, playerTag, brawlerId])
  @@index([brawlerId, day])
  @@map("player_battle_daily")
}

/// Daily roll-up of `battle_team_samples`, one row per (subject, other)
/// pairing rather than one per battle.
///
/// The raw table stores two id arrays per battle and every read `unnest`s
/// them, so the pairing is already the real grain — this just stops
/// re-expanding it on every query. Row count only falls about 2x, but the row
/// is a fifth the width once the arrays, the battle key and the player tag are
/// gone, which is where the saving is.
model BrawlerPairDaily {
  day            DateTime @db.Date
  /// The sampled player's brawler: the subject of the pairing.
  brawlerId      Int      @map("brawler_id")
  otherBrawlerId Int      @map("other_brawler_id")
  /// "enemy" | "ally", from the subject's perspective.
  side           String
  /// "victory" | "defeat" | "draw", from the subject's side.
  result         String
  battles        Int

  /*
   * The largest of the roll-ups, and the one where this matters most: measured
   * with a surrogate id, its indexes cost more than its data (18.3 MB against
   * 12.0 MB), because a five-column unique constraint and a primary key were
   * describing the same rows twice over. Promoting the natural key to the
   * primary key removes the duplicate outright.
   */
  @@id([day, brawlerId, otherBrawlerId, side, result])
  @@index([brawlerId, day])
  @@map("brawler_pair_daily")
}

/// Each brawler's own record in the team sample, per day.
///
/// Every pairing read reports an *edge* against the brawler's average in the
/// same sample rather than an absolute rate, so all of them need this baseline
/// alongside the pairings. It cannot be recovered by summing
/// `brawler_pair_daily`, where one battle contributes several pairs, so it is
/// counted once here — about 106 rows a day.
model BrawlerTeamDaily {
  day       DateTime @db.Date
  brawlerId Int      @map("brawler_id")
  wins      Int
  /// Every sampled team battle, draws included — the denominator the pairing
  /// reads use, which sum `brawler_pair_daily.battles` the same way.
  decided   Int

  @@id([day, brawlerId])
  @@map("brawler_team_daily")
}

/// What each roll-up day was last built from, so unchanged days are not
/// rebuilt.
///
/// The fold is idempotent, which made rebuilding the trailing days every run
/// look free. It is not: rewriting ~123k identical rows twice a day is ~123k
/// rows of write-ahead log twice a day, and on Neon the retained WAL is
/// *billed storage* — the console's "Storage" figure is data plus history, so
/// churn that never changes an answer still fills the plan. Measured on
/// 2026-08-24, history was 0.18 GB of a 0.49 GB total.
///
/// `rawWatermark` is the newest `created_at` among the raw rows folded into
/// this day. The sampler only ever appends, so if it has not moved, no battle
/// has been added to that day since it was last folded and the fold would
/// reproduce the rows already there.
///
/// Safe only because a day inside the rebuild window is never partially
/// pruned: the prune cuts at a 72-hour timestamp, and the oldest rebuildable
/// day starts at midnight two days back, which is always later. If those two
/// windows ever cross, a pruned day would look "changed" and be re-folded from
/// what survived — undercounting it permanently. See RAW_BATTLE_RETENTION_DAYS.
model RollupWatermark {
  day          DateTime @db.Date
  /// "battles" | "teams" — the two raw tables, folded on separate day lists.
  source       String
  rawWatermark DateTime @map("raw_watermark")
  foldedAt     DateTime @updatedAt @map("folded_at")

  @@id([day, source])
  @@map("rollup_watermarks")
}
