# SITE_ADDRESS controls TLS:
#   :80            — plain HTTP, for verifying on the raw IP before DNS moves
#   brawlzone.net  — Caddy obtains and renews a Let's Encrypt certificate
#
# Set it in .env.production; do not edit this file to switch.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Refused here rather than in src/proxy.ts, which is where every other
	# crawler rule lives. The difference is what it costs: the proxy runs
	# inside Next, so a refusal there still boots the app. Measured over 24h
	# on 2026-08-28, meta-externalagent was 58% of all traffic -- 17,419
	# requests, ~600/hour, 15,193 of them 404s on /player/. That is the app
	# starting seventeen thousand times a day to say no to one bot.
	#
	# This is Meta's AI-TRAINING crawler. `facebookexternalhit`, which unfurls
	# links shared on Facebook and Messenger, is a different agent and is not
	# matched here -- link previews are unaffected. So is Googlebot: search
	# indexing continues exactly as before.
	#
	# Kept in step with BLOCKED_AGENTS in src/lib/crawl-policy.ts, which is
	# what robots.txt reads. Neither enforces the other: robots.txt is a
	# request, this is the answer for an agent that ignores it.
	# header_regexp, not header_regex -- the latter is not a registered module
	# and Caddy rejects the whole file, which `caddy reload` then declines,
	# leaving the previous config running. Silently, unless someone checks the
	# reload's exit code, which auto-deploy.sh now does.
	@blocked_agents header_regexp User-Agent (?i)meta-externalagent
	respond @blocked_agents "Refused. See /robots.txt" 403

	# There was no access log at all until 2026-08-27, which meant no way to
	# answer "which crawler is hitting what" -- the exact question behind the
	# outage that moved this project off Vercel.
	#
	# roll_disabled hands retention to logrotate (daily, 30 days) so every log
	# on the box has one policy in one place. logrotate uses copytruncate,
	# which Caddy tolerates because it appends rather than seeking.
	log {
		output file /var/log/brawlzone/access.log {
			roll_disabled
		}
		format json
	}

	# Next sets its own cache headers per route (see AGENTS.md trap 2) and
	# Caddy must not override them.
	reverse_proxy {
		# Resolved per-refresh rather than once at startup. Docker gives a
		# recreated container a NEW IP, and a statically-resolved upstream
		# keeps dialling the dead one -- which fails instantly instead of
		# being retried, so lb_try_duration never got a chance and deploys
		# still emitted a 502. Measured 2026-08-27.
		dynamic a {
			name app
			port 3000
			refresh 1s
		}

		# Every deploy recreates the app container, and Caddy returned 502 for
		# the few seconds it was gone -- the access log caught real requests
		# hitting that window. Retrying a refused connection for 30s turns a
		# deploy from a visible error into a short wait.
		#
		# Safe here because Caddy only retries when the connection itself
		# failed, so no request is ever delivered twice, and this site is
		# read-only GET traffic regardless.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# www redirects to the canonical host instead of serving a second copy. Two
# hostnames answering with identical content doubles the crawlable URL set,
# and hosting cost here scales with that number rather than with visitors.
#
# Defaults to an unused internal port so the block is inert during raw-IP
# verification, when there is no www hostname to answer for.
{$WWW_ADDRESS::8443} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
