# Global options. Must be the first block in the file and must be unnamed.
{
	servers {
		# Who is allowed to tell us who the client is.
		#
		# Behind Cloudflare's proxy every request arrives from a Cloudflare
		# address, so without this the access log records Cloudflare instead of
		# the visitor -- and the log is the only thing that can answer "which
		# crawler is hitting what". That question is what identified the
		# Lightpanda flood on 2026-09-28 (19,975 of 20,000 requests, spread
		# across thousands of addresses so no single IP looked remarkable). A
		# log full of 104.16.x would have hidden the shape entirely.
		#
		# `trusted_proxies` is the security half: CF-Connecting-IP is just a
		# header, and anything reaching us directly could set it to whatever it
		# liked. Honouring it ONLY from Cloudflare's own ranges means a
		# direct-to-origin request cannot forge its own identity.
		#
		# Inert while the DNS records are grey-cloud: no traffic arrives from
		# these ranges, so nothing matches and client_ip stays the real peer.
		# That is why this can ship before the cutover rather than during it.
		#
		# Fetched from cloudflare.com/ips-v4 and /ips-v6 on 2026-09-28. They
		# change rarely but they do change, and a stale list here silently
		# degrades to logging Cloudflare's address rather than failing loudly.
		# One line: Caddyfile does not continue a directive across lines.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# SITE_ADDRESS controls TLS:
#   :80            — plain HTTP, for verifying on the raw IP before DNS moves
#   brawlzone.net  — Caddy obtains and renews a Let's Encrypt certificate
#
# Set it in .env.production; do not edit this file to switch.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Refused here rather than in src/proxy.ts, which is where every other
	# crawler rule lives. The difference is what it costs: the proxy runs
	# inside Next, so a refusal there still boots the app. Measured over 24h
	# on 2026-08-28, meta-externalagent was 58% of all traffic -- 17,419
	# requests, ~600/hour, 15,193 of them 404s on /player/. That is the app
	# starting seventeen thousand times a day to say no to one bot.
	#
	# This is Meta's AI-TRAINING crawler. `facebookexternalhit`, which unfurls
	# links shared on Facebook and Messenger, is a different agent and is not
	# matched here -- link previews are unaffected. So is Googlebot: search
	# indexing continues exactly as before.
	#
	# `lightpanda` was added 2026-09-28, after a weekend of it. Lightpanda is a
	# headless browser built for scraping, and over that weekend it was 19,975 of
	# every 20,000 requests -- 99.9% of all traffic -- walking every top-level
	# page in a loop from thousands of distinct addresses, none of them making
	# more than ~36 requests. The app process sat pegged at 100% CPU for three
	# days and the container went unhealthy.
	#
	# AGENTS.md trap 8 says blocking by user agent is NOT the fix, and that is
	# still true of the flood it describes: that one sent Chrome's UA from
	# thousands of addresses, so there was nothing to match on. This one names
	# itself in every request. The lesson is not "never match the agent", it is
	# "match on what is actually distinctive" -- and here that is the agent.
	# If it ever starts spoofing Chrome, this line stops working and the answer
	# becomes rate limiting at the edge, which this image cannot do.
	#
	# Kept in step with BLOCKED_AGENTS in src/lib/crawl-policy.ts, which is
	# what robots.txt reads. Neither enforces the other: robots.txt is a
	# request, this is the answer for an agent that ignores it.
	# header_regexp, not header_regex -- the latter is not a registered module
	# and Caddy rejects the whole file, which `caddy reload` then declines,
	# leaving the previous config running. Silently, unless someone checks the
	# reload's exit code, which auto-deploy.sh now does.
	# There was no access log at all until 2026-08-27, which meant no way to
	# answer "which crawler is hitting what" -- the exact question behind the
	# outage that moved this project off Vercel.
	#
	# roll_disabled hands retention to logrotate (daily, 30 days) so every log
	# on the box has one policy in one place. logrotate uses copytruncate,
	# which Caddy tolerates because it appends rather than seeking.
	log {
		output file /var/log/brawlzone/access/access.log {
			roll_disabled
		}
		format json
	}

	# Next sets its own cache headers per route (see AGENTS.md trap 2) and
	# Caddy must not override them.
	# handle blocks, not bare directives: they are mutually exclusive and match
	# in written order, so "refuse this agent", "this path goes to analytics"
	# and "everything else goes to the app" cannot be reordered by Caddy's own
	# directive sorting into something that never fires.
	#
	# header_regexp, not header_regex -- the latter is not a registered module
	# and Caddy rejects the whole file, which `caddy reload` then declines,
	# leaving the previous config running. Silently, unless someone checks the
	# reload's exit code, which auto-deploy.sh now does.
	@blocked_agents header_regexp User-Agent (?i)meta-externalagent|lightpanda
	handle @blocked_agents {
		respond "Refused. See /robots.txt" 403
	}

	# The draft-state flood, refused here so that Node never sees it.
	#
	# `src/proxy.ts` already refuses this traffic, and correctly: its Referer
	# is `https://brawlzone.net` with nothing after the host, which a browser
	# cannot produce (a document URL always serialises with at least "/").
	# But the proxy runs INSIDE the app, and AGENTS.md trap 8 is what that
	# cost on 2026-09-11: when the app saturated, the limiter went down with
	# it. Measured 2026-09-21 after a week unattended, the same flood was at
	# 81 requests a second, 99% of all traffic, every one of them a Node
	# middleware invocation returning a 429. The site held; the sampler,
	# landing on top of that every two hours, did not always.
	#
	# `header` without a wildcard is an exact match, so the trailing-slash
	# form a real browser sends from the home page does not match. If the
	# flood ever appends the slash it falls through to the app's own limiter
	# and the site behaves as it did before this block existed -- the
	# advantage is lost, the protection is not.
	#
	# Only /draft, not every limited prefix: this is one measured flood with
	# one measured shape, and a broader rule would be a guess.
	@draft_flood {
		path /draft/*
		header Referer https://brawlzone.net
	}
	handle @draft_flood {
		header Retry-After 5
		header Cache-Control no-store
		respond "Too many requests. Try again in a moment." 429
	}

	handle {
		reverse_proxy {
			# Resolved per-refresh rather than once at startup. Docker gives a
			# recreated container a NEW IP, and a statically-resolved upstream
			# keeps dialling the dead one -- which fails instantly instead of
			# being retried, so lb_try_duration never got a chance and deploys
			# still emitted a 502. Measured 2026-08-27.
			dynamic a {
				name app
				port 3000
				refresh 1s
			}
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# www redirects to the canonical host instead of serving a second copy. Two
# hostnames answering with identical content doubles the crawlable URL set,
# and hosting cost here scales with that number rather than with visitors.
#
# Defaults to an unused internal port so the block is inert during raw-IP
# verification, when there is no www hostname to answer for.
{$WWW_ADDRESS::8443} {
	# Logged like the main host. It was not, until 2026-09-28, and the gap
	# only surfaced while verifying the Cloudflare cutover: `www` was proxied,
	# the redirect was working, and nothing about it appeared in the access
	# log -- which reads exactly like "the request never reached the origin".
	# A block that serves traffic and records none of it can only be debugged
	# by guessing.
	log {
		output file /var/log/brawlzone/access/access.log {
			roll_disabled
		}
		format json
	}

	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Analytics, on its own host.
#
# Not a path on the main domain, which is where this started: Umami is a
# Next.js app and Next bakes `basePath` at BUILD time, so the BASE_PATH env var
# the image accepts does nothing -- it served /login while Caddy asked it for
# /analytics/login. Stripping the prefix instead would have collided its
# /_next/ assets with the site's own.
#
# The cost is that the tracking script lives on a recognisable analytics
# hostname, which some ad blockers filter. Correctness first.
{$ANALYTICS_ADDRESS::8444} {
	encode zstd gzip
	reverse_proxy umami:3000
}
