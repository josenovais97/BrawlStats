<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget (1.40): Ranked meta, top five. Refreshed by the hourly check (AlertJob), so the
     launcher's own timer is off. Settings open on placement (optional) and
     again from the widget's long-press menu. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="net.brawlzone.bubble.WidgetConfigActivity"
    android:description="@string/widget_meta_description"
    android:initialLayout="@layout/widget_meta"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="220dp"
    android:minResizeHeight="220dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_meta"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
