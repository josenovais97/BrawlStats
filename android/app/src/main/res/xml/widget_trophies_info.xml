<?xml version="1.0" encoding="utf-8"?>
<!-- Trophies widget (1.41). Refreshed by the hourly check (AlertJob), so the
     launcher's own timer is off. No settings: the default background. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_trophies_description"
    android:initialLayout="@layout/widget_trophies"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="150dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_trophies"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
