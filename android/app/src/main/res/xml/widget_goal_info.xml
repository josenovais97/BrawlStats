<?xml version="1.0" encoding="utf-8"?>
<!-- Next goal widget (1.41). Refreshed by the hourly check (AlertJob), so the
     launcher's own timer is off. No settings: the default background. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_goal_description"
    android:initialLayout="@layout/widget_goal"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="100dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_goal"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
