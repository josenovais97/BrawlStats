<?xml version="1.0" encoding="utf-8"?>
<!--
  Both layers are bitmaps, and that is the point.

  This was previously an <adaptive-icon> whose foreground was `@drawable/
  bubble_background` — a <shape>, reused from the floating bubble itself. A
  shape drawable has no intrinsic size: `getIntrinsicWidth()` returns -1. Any
  process that rasterises an app icon does roughly

      Bitmap.createBitmap(icon.getIntrinsicWidth(), icon.getIntrinsicHeight(), …)

  which throws `IllegalArgumentException: width and height must be > 0` — in
  the *caller's* process. The launcher sizes icons explicitly and survived; the
  Settings app does not, so "Display over other apps" crashed for this package
  and the permission became ungrantable while the app was installed.

  An app icon must always have real dimensions. Density PNGs below cover every
  path, including pre-26 where this file does not apply.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
