<?xml version="1.0" encoding="utf-8"?>
<!-- "Follow BrawlZone" button (1.40): the platform's colours, a simple glyph,
     the game-style dark outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="@color/outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#5865F2" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/glyph_chat" android:left="15dp" android:top="15dp" android:right="15dp" android:bottom="15dp" />
</layer-list>
