<?xml version="1.0" encoding="utf-8"?>
<!-- The screen: a saturated blue menu gradient, brightest at the top where the
     hero sits, falling to deep navy. A soft radial glow behind the hero gives
     the page a light source, the way game menus are lit. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/background" /></item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2A3F9E"
                android:centerColor="#15215C"
                android:endColor="@color/background" />
        </shape>
    </item>
    <item android:gravity="top" android:height="420dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.1"
                android:startColor="#334FC6FF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
