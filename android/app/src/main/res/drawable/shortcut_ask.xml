<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcut icon for Ask Bubble (1.42): violet, like its button in the panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp" />
            <gradient android:type="linear" android:angle="270"
                android:startColor="#C9A8FF" android:endColor="#7A4CFF" />
            <stroke android:width="2dp" android:color="#2A1466" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_sparkle"
        android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp" />
</layer-list>
