    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline" />
        </shape>
    </item>
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#101A45" />
        </shape>
    </item>
</layer-list>
