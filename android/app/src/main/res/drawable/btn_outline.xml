<?xml version="1.0" encoding="utf-8"?>
<!-- A secondary action, in the panel blue.
     A chunky 3D button: a bright face on a darker depth edge, inside a thick
     dark outline. Pressed, the face drops onto the edge, so a tap feels like a
     press rather than a highlight. Shapes and colours only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/blue_depth" />
                <corners android:radius="16dp" />
                <stroke android:width="2dp" android:color="@color/outline" />
            </shape>
        </item>
        <item android:left="2dp" android:right="2dp" android:top="5dp" android:bottom="2dp">
            <shape android:shape="rectangle">
                <gradient android:type="linear" android:angle="270"
                    android:startColor="@color/blue_face_top" android:endColor="@color/blue_face" />
                <corners android:radius="14dp" />
            </shape>
        </item>
        <!-- Top-edge highlight: the light catching the face. -->
        <item android:left="10dp" android:right="10dp" android:top="8dp" android:height="5dp" android:gravity="top">
            <shape android:shape="rectangle">
                <solid android:color="@color/highlight" />
                <corners android:radius="3dp" />
            </shape>
        </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/blue_depth" />
                <corners android:radius="16dp" />
                <stroke android:width="2dp" android:color="@color/outline" />
            </shape>
        </item>
        <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="6dp">
            <shape android:shape="rectangle">
                <gradient android:type="linear" android:angle="270"
                    android:startColor="@color/blue_face_top" android:endColor="@color/blue_face" />
                <corners android:radius="14dp" />
            </shape>
        </item>
        <!-- Top-edge highlight: the light catching the face. -->
        <item android:left="10dp" android:right="10dp" android:top="5dp" android:height="5dp" android:gravity="top">
            <shape android:shape="rectangle">
                <solid android:color="@color/highlight" />
                <corners android:radius="3dp" />
            </shape>
        </item>
        </layer-list>
    </item>
</selector>
