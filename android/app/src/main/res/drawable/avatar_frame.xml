<?xml version="1.0" encoding="utf-8"?>
<!-- The player's icon frame: a gold edge in a dark outline, like a badge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/brand" />
        </shape>
    </item>
</layer-list>
