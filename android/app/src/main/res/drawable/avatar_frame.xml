<?xml version="1.0" encoding="utf-8"?>
<!-- The account avatar's plate. Rounded rather than circular: the game's own
     player icons are square artwork, and circle-cropping them clips the badge
     corners the art is drawn to include. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface_2" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/border_strong" />
</shape>
