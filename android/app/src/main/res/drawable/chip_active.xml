<?xml version="1.0" encoding="utf-8"?>
<!-- The active pill, edged in gold. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/brand" />
        </shape>
    </item>
</layer-list>
