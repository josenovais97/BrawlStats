<?xml version="1.0" encoding="utf-8"?>
<!-- The selected filter option: brand ring with a filled centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp" />
            <stroke android:width="2dp" android:color="@color/brand" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand" />
        </shape>
    </item>
</layer-list>
