<?xml version="1.0" encoding="utf-8"?>
<!-- A small pill for counts and secondary actions, outlined like everything else. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</layer-list>
