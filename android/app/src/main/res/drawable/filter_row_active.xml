<?xml version="1.0" encoding="utf-8"?>
<!-- The filter option in force: raised further and edged in gold. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFC53D">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/outline" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_3" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="@color/brand" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
