<?xml version="1.0" encoding="utf-8"?>
<!-- The set-up prompt: the card surface with a warm brand wash and edge, so it
     reads as the next step rather than as one more section. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="linear" android:angle="315"
        android:startColor="#2EFFC53D" android:endColor="@color/surface" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#66FFC53D" />
</shape>
