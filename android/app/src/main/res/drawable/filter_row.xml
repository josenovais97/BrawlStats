<?xml version="1.0" encoding="utf-8"?>
<!-- A filter option. Ripple so a tap visibly lands: these are choices, and a
     choice that does not react to a finger reads as a label. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFC53D">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</ripple>
