<?xml version="1.0" encoding="utf-8"?>
<!-- Friends widget (1.40): the player and up to five friends by elo, with each one's week. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bubble_badge"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/bubble_glyph" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="BRAWLZONE"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_friends_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textColor="@color/brand"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_friends_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_friends_none"
        android:textColor="@color/foreground"
        android:textSize="14sp"
        android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_friend_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_friend_pos_1"
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/widget_friend_badge_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_friend_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_friend_elo_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/brand"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_friend_week_1"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
