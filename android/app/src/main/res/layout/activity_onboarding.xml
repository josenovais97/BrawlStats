<?xml version="1.0" encoding="utf-8"?>
<!--
  First-run setup (1.40). Three cards, one per step, each with its number
  badge, a line of why, a picture where it helps, and one button. The next
  step to do is lit; done steps turn their badge green.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onb_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/onb_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bubble_badge"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/bubble_glyph" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="BRAWLZONE BUBBLE"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onb_title"
                    android:textColor="@color/foreground"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onb_subtitle"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <!-- Step 1: the overlay permission. -->
        <LinearLayout
            android:id="@+id/onb_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/onb_badge1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/brand_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/onb_step1_title"
                    android:textColor="@color/foreground"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onb_step1_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/onb_img1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:adjustViewBounds="true"
                android:background="@drawable/field"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/onb_float" />

            <Button
                android:id="@+id/onb_allow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_gold"
                android:stateListAnimator="@null"
                android:text="@string/onb_step1_cta"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Step 2: the player tag, optional. -->
        <LinearLayout
            android:id="@+id/onb_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/onb_badge2"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/brand_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/onb_step2_title"
                    android:textColor="@color/foreground"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onb_step2_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/onb_clip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_cta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/brand"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/onb_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:background="@drawable/field"
                android:hint="#2RLCPVGUG"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="16"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp"
                android:paddingBottom="15dp"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/onb_tag_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/onb_save_tag"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_gold"
                    android:stateListAnimator="@null"
                    android:text="@string/onb_step2_cta"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/onb_skip_tag"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="@string/onb_skip_step"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3: into the game. -->
        <LinearLayout
            android:id="@+id/onb_step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/onb_badge3"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/step_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/brand_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/onb_step3_title"
                    android:textColor="@color/foreground"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onb_step3_body"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/onb_img3"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/field"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/onb_panel" />

            <Button
                android:id="@+id/onb_play"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_gold"
                android:stateListAnimator="@null"
                android:text="@string/onb_step3_cta"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/onb_skip_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/onb_skip_all"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
