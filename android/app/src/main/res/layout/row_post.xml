<?xml version="1.0" encoding="utf-8"?>
<!-- One post of the squad feed (1.42, Feed/FeedView): who and when, the
     headline, a second line or the awards rows, and the reaction bar. The card
     background (tinted by the kind of post) is drawn in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/post_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/avatar_frame"
                android:contentDescription="@null"
                android:padding="4dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/post_emoji"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/post_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/foreground"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/post_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/post_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/post_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/foreground"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/post_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/post_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/post_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/post_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
