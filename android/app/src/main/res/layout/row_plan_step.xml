<?xml version="1.0" encoding="utf-8"?>
<!--
  One upgrade in the plan.

  Inflated per step rather than written three times into the screen, because
  the plan is between zero and three long and a fixed set of rows would have to
  be hidden individually — which is how a card ends up with a stale name in it
  when the shorter answer arrives second.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/step_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <ImageView
            android:id="@+id/step_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/chip"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/step_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step_gain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
