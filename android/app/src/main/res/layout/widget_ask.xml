<?xml version="1.0" encoding="utf-8"?>
<!-- "Ask Bubble" widget (1.42): tap the bar to type, the mic to speak (AskWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ask_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ask_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_ask_icon" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_ask_hint"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/widget_ask_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/ask_voice_prompt"
        android:padding="8dp"
        android:src="@drawable/ic_mic" />
</LinearLayout>
