<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher screen, as a layout rather than views built in code.

  The previous version assembled this in Kotlin and passed raw pixels to
  setPadding — so "56" was 56 physical pixels, which is 13dp on a 420dpi phone
  and 56dp on an old 160dpi one. The margins were wrong on every modern device,
  which is most of why the screen read as cheap. Every dimension here is dp.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!--
          Hero.

          The mark, the name and the version on one line, with the sentence
          under it. It was a brand row, then a gap, then a headline, then a
          gap — three stacked blocks saying one thing, which is how a screen
          ends up looking like a form.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bubble_badge"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/bubble_glyph" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Bubble"
                    android:textColor="@color/foreground"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="BRAWLZONE"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/version_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.3"
            android:text="The Ranked tier list, floating on top of the game. Tap it mid-draft, tap it again and it folds away."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <!--
          State and action in one card.

          They were a status card, then a gold button, then two more buttons —
          four stacked full-width blocks for what is really one decision. The
          card now says where the bubble is and offers the one thing worth
          doing about it; the secondary actions share a row beneath.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Checking permission…"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_gold"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null"
                android:text="Start bubble"
                android:textAllCaps="false"
                android:textColor="@color/brand_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!--
              Side by side, and a hidden Quick Settings button collapses rather
              than leaving a gap: a LinearLayout gives no space to a GONE
              child, so Stop takes the full width on Android 12 and below where
              the tile cannot be added from an app.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/stop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Stop"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/add_tile"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Quick Settings"
                    android:textAllCaps="false"
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shown only after a grant attempt has actually failed. -->
        <TextView
            android:id="@+id/restricted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_warn"
            android:lineSpacingMultiplier="1.35"
            android:padding="16dp"
            android:text="The toggle is greyed out?"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="YOUR ACCOUNT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/muted" />

        <!--
            One card, not a stack of loose controls.

            The tag, who it resolved to, and what the filters do to that roster
            all answer one question — "is the panel set up for me" — so they
            share a surface and read top to bottom. The identity block sits
            above the switches because it is the thing that has to be right
            before any switch means anything.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Identity. Hidden until a tag resolves: an empty avatar frame
                 with no name beside it is a placeholder, and a screen of
                 placeholders looks unfinished rather than ready. -->
            <LinearLayout
                android:id="@+id/account_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/account_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/avatar_frame"
                    android:contentDescription="Player icon"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/account_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/foreground"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/account_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trophy" />

                        <TextView
                            android:id="@+id/account_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- The counts the two filters actually produce, so a switch is
                 not a guess about what it will do. -->
            <LinearLayout
                android:id="@+id/account_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="11dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brawlers" />

                    <TextView
                        android:id="@+id/chip_owned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/foreground"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="owned"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="11dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_power_11" />

                    <TextView
                        android:id="@+id/chip_eleven"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/foreground"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="power 11"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="11dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_hypercharge" />

                    <TextView
                        android:id="@+id/chip_hyper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/foreground"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hyper"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:background="@drawable/field"
                android:hint="#2RLCPVGUG"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="16"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp"
                android:paddingBottom="15dp"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tag_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:text="Optional. Add your tag and the panel marks the picks you can actually take." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="4dp"
                android:background="@color/border" />

            <!--
                Each switch carries the sentence explaining it. A bare label is
                a guess about behaviour, and these three change what the panel
                shows mid-draft, which is the worst moment to discover you
                guessed wrong.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Power 11 only"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Ignore brawlers you have not maxed"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/only_eleven"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hypercharged only"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Power 11 and the hypercharge unlocked"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/only_hypercharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hide, do not grey"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Remove what you cannot field from the panel"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/hide_unusable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="HOW IT WORKS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:padding="4dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/brand" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/foreground"
                    android:text="Tap the bubble to open the panel; tap it again to fold it away." />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="52dp"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/brand" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/foreground"
                    android:text="Drag the bubble anywhere — it rests against the nearest edge." />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="52dp"
                android:background="@color/border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/brand" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/foreground"
                    android:text="Drag it onto the ✕ at the bottom to close it, use Stop in the notification, or the BrawlZone tile in Quick Settings — that tile also starts it, from inside the game." />
            </LinearLayout>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/border" />

        <!-- The screen ended on the last numbered step, which reads as the
             page having been cut off rather than finished. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingMultiplier="1.3"
            android:text="Numbers measured from sampled Ranked battles, the same ones brawlzone.net shows. Free, no account, no ads."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/footer_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="brawlzone.net"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
