<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The overlay permission is the whole reason this app exists rather than
      being a page on the site: no web API can draw over another app, and this
      one is granted by the user in Settings rather than at install time.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Needed to hand a downloaded APK to the package installer ourselves.
      Without it the app can fetch its own update and then not offer it, which
      leaves the file sitting in Downloads with nothing pointing at it — the
      shape the update button failed in more than once.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BrawlZone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          A foreground service, not a background one. An overlay that Android
          can kill mid-draft is worse than no overlay, and a visible ongoing
          notification is also the honest signal that something is drawing over
          your screen.
        -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draws a movable overlay showing live Brawl Stars map picks while the game is in the foreground." />
        </service>


        <!--
          A Quick Settings tile that toggles the bubble from the notification
          shade — one swipe from inside the game, which is where the bubble is
          wanted and where opening an app screen is exactly wrong. The
          BIND_QUICK_SETTINGS_TILE permission is what lets the system, and only
          the system, bind to it.
        -->
        <service
            android:name=".BubbleTileService"
            android:exported="true"
            android:icon="@drawable/bubble_glyph"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
