<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The overlay permission is the whole reason this app exists rather than
      being a page on the site: no web API can draw over another app, and this
      one is granted by the user in Settings rather than at install time.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Draft scanning. The permission alone grants nothing: every capture session
      still needs the user to accept the system dialog, and Android shows a
      recording indicator for as long as one is open.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BrawlZone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          A foreground service, not a background one. An overlay that Android
          can kill mid-draft is worse than no overlay, and a visible ongoing
          notification is also the honest signal that something is drawing over
          your screen.
        -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draws a movable overlay showing live Brawl Stars map picks while the game is in the foreground." />
        </service>

        <!--
          Shows the screen-capture dialog and hands the result to the service.
          Excluded from recents because it is a dialog, not a screen, and a
          blank entry in the task switcher is just confusing.
        -->
        <activity
            android:name=".ScanConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.BrawlZone.Invisible" />
    </application>
</manifest>
