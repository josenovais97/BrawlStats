<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The overlay permission is the whole reason this app exists rather than
      being a page on the site: no web API can draw over another app, and this
      one is granted by the user in Settings rather than at install time.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Only to ask "is there a connection", so an open with no signal shows the
      last saved list instead of an error. A normal permission: granted at
      install, no prompt, and it reveals nothing about which network.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Keeps the hourly reward and season check scheduled after a restart
      (1.40). A normal permission: no prompt, and it only lets the job
      scheduler bring back the one periodic job this app registers.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      "Open Brawl Stars" (1.40). Since Android 11 an app can see another app
      only if it names it here; without this the launch intent comes back
      empty and the button would always say the game is not installed.
    -->
    <queries>
        <package android:name="com.supercell.brawlstars" />
    </queries>

    <!--
      Needed to hand a downloaded APK to the package installer ourselves.
      Without it the app can fetch its own update and then not offer it, which
      leaves the file sitting in Downloads with nothing pointing at it — the
      shape the update button failed in more than once.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:label="${appLabel}"
        android:theme="@style/Theme.BrawlZone">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          First-run setup (1.40): three steps instead of a long screen, because
          most installs never finished setting up (34 installs, 8 first opens).
        -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The hourly check for free rewards and Ranked season dates (1.40),
          which also refreshes the home-screen widget. Only the system's job
          scheduler can bind to it.
        -->
        <service
            android:name=".AlertJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          Widget settings (1.40): which mode the top picks are for, the free
          reward on or off, and the background. Opened by the launcher when a
          widget is placed or reconfigured, so it must be exported.
        -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.BrawlZone">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SmallRewardWidget"
            android:exported="false"
            android:label="@string/widget_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <receiver
            android:name=".MetaWidget"
            android:exported="false"
            android:label="@string/widget_meta_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_meta_info" />
        </receiver>

        <receiver
            android:name=".RankWidget"
            android:exported="false"
            android:label="@string/widget_rank_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rank_info" />
        </receiver>

        <!-- Friends ladder (1.40). -->
        <receiver
            android:name=".FriendsWidget"
            android:exported="false"
            android:label="@string/widget_friends_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_friends_info" />
        </receiver>

        <!-- Trophies (1.41): live trophy maps with your best brawler to push. -->
        <receiver
            android:name=".TrophiesWidget"
            android:exported="false"
            android:label="@string/widget_trophies_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trophies_info" />
        </receiver>

        <!-- Next goal (1.41): wins to the next rank and today's goal. -->
        <receiver
            android:name=".GoalWidget"
            android:exported="false"
            android:label="@string/widget_goal_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goal_info" />
        </receiver>

        <!-- Share cards (1.40): the drawn PNG, handed to the share sheet from the cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Home-screen widget: the newest free reward and today's top pick. -->
        <receiver
            android:name=".RewardsWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rewards_info" />
        </receiver>

        <!--
          A foreground service, not a background one. An overlay that Android
          can kill mid-draft is worse than no overlay, and a visible ongoing
          notification is also the honest signal that something is drawing over
          your screen.
        -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draws a movable overlay showing live Brawl Stars map picks while the game is in the foreground." />
        </service>


        <!--
          A Quick Settings tile that toggles the bubble from the notification
          shade — one swipe from inside the game, which is where the bubble is
          wanted and where opening an app screen is exactly wrong. The
          BIND_QUICK_SETTINGS_TILE permission is what lets the system, and only
          the system, bind to it.
        -->
        <service
            android:name=".BubbleTileService"
            android:exported="true"
            android:icon="@drawable/bubble_glyph"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
